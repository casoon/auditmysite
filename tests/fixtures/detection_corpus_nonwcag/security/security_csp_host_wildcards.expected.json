    },
    {
      "rule_id": "Content-Security-Policy:wildcard_source",
      "verdict": "violation"
    },
    {
      "rule_id": "Content-Security-Policy:unsafe_inline_script",
      "verdict": "pass"
    },
    {
      "rule_id": "Content-Security-Policy:unsafe_eval_script",
