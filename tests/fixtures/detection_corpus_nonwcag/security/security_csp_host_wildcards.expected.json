    },
    {
      "rule_id": "Content-Security-Policy:unsafe_inline_style",
      "verdict": "pass"
    },
    {
      "rule_id": "Content-Security-Policy:missing_object-src",
      "verdict": "pass"
    },
    {
      "rule_id": "Content-Security-Policy:missing_base-uri",
