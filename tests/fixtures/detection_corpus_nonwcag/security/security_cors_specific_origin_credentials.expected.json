{
  "case": "security_cors_specific_origin_credentials",
  "note": "Credentials for one named origin is the valid credentialed form.",
  "response_headers": {
    "Content-Security-Policy": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), camera=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Access-Control-Allow-Origin": "https://app.example",
    "Access-Control-Allow-Credentials": "true"
  },
  "expectations": [
    {
      "rule_id": "HTTPS:missing_https",
      "verdict": "violation"
    },
    {
      "rule_id": "Access-Control-Allow-Origin:cors_wildcard_credentials",
      "verdict": "pass"
    }
  ]
}
