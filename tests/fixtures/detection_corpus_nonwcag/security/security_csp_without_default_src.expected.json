{
  "case": "security_csp_without_default_src",
  "note": "No object-src and no default-src to fall back to: plugins are unrestricted.",
  "response_headers": {
    "Content-Security-Policy": "script-src 'self'; base-uri 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), camera=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin"
  },
  "expectations": [
    {
      "rule_id": "HTTPS:missing_https",
      "verdict": "violation"
    },
    {
      "rule_id": "Content-Security-Policy:missing_object-src",
      "verdict": "violation"
    },
    {
      "rule_id": "Content-Security-Policy:missing_base-uri",
      "verdict": "pass"
    },
    {
      "rule_id": "Content-Security-Policy:missing_frame-ancestors",
      "verdict": "pass"
    },
    {
      "rule_id": "Content-Security-Policy:unsafe_inline_script",
      "verdict": "pass"
    }
  ]
}
