{
  "case": "security_csp_policy_list",
  "note": "Two enforced CSP headers form one policy list; a resource loads only if every policy allows it (CSP3, 'Policy lists'). The first allows inline script, the second does not; each covers what the other lacks.",
  "response_headers": {},
  "fixture": {
    "raw_response_headers": [
