        "default-src 'self'; object-src 'none'; frame-ancestors 'none'"
      ],
      [
        "X-Content-Type-Options",
        "nosniff"
      ],
      [
        "Referrer-Policy",
        "no-referrer"
      ],
      [
        "Permissions-Policy",
        "camera=()"
      ],
      [
        "Cross-Origin-Opener-Policy",
        "same-origin"
      ],
      [
        "Cross-Origin-Resource-Policy",
        "same-origin"
      ]
    ]
  },
