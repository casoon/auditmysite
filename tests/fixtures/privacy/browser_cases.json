  {"name": "clean page", "why": "No third-party request, nothing stored: checks 1-5 have nothing to look at; both policy links are present.",
   "body": "",
   "expect": {"outcomes": "AAAAAN", "findings": []}},

  {"name": "own script, own image, own cookie", "why": "Own-host requests are never third-party; an unlisted cookie name is no finding (nothing stored that a provider documents).",
   "body": "<img src='/own.gif' alt=''><script src='/own.js'></script><script>document.cookie='lang=en; path=/'</script>",
   "set_cookie": ["session_id=1; Path=/; HttpOnly"],
   "expect": {"outcomes": "ANAAAN", "findings": []}},

  {"name": "google analytics script before consent", "why": "A request to a documented analytics host is evidence; the provider is seated in the US; no consent trace of any kind.",
   "body": "<script src='https://www.google-analytics.com/analytics.js'></script>",
   "requested": ["www.google-analytics.com"], "truth": ["google-analytics"],
   "expect": {"outcomes": "FANFFN", "findings": [
     ["tracking_request_before_consent", "evidence", "analytics", ""],
     ["third_country_provider", "indication", "", ""],
     ["no_consent_platform_detected", "indication", "", ""]]}},

  {"name": "tag manager only", "why": "A tag manager may fire tags: indication, not evidence.",
   "body": "<script async src='https://www.googletagmanager.com/gtm.js?id=GTM-CORPUS'></script>",
   "requested": ["www.googletagmanager.com"], "truth": ["google-tag-manager"],
   "expect": {"outcomes": "FANFFN", "findings": [
     ["tracking_request_before_consent", "indication", "tag_manager", ""],
     ["third_country_provider", "indication", "", ""],
     ["no_consent_platform_detected", "indication", "", ""]]}},

  {"name": "pixel fired by a tag manager script", "why": "The tag manager request and the pixel it triggers are two providers; both count, the pixel as evidence.",
   "body": "<script src='https://www.googletagmanager.com/gtm.js?id=GTM-CORPUS'></script><script>new Image().src='https://www.google-analytics.com/g/collect?v=2&tid=G-CORPUS';</script>",
   "requested": ["www.googletagmanager.com", "www.google-analytics.com"], "truth": ["google-tag-manager", "google-analytics"],
   "expect": {"outcomes": "FANFFN", "findings": [
     ["tracking_request_before_consent", "indication", "tag_manager", ""],
     ["tracking_request_before_consent", "evidence", "analytics", ""],
     ["third_country_provider", "indication", "", ""],
     ["no_consent_platform_detected", "indication", "", ""]]}},

