  {"name": "tracker cookie and storage keys set by script", "why": "Cookie names and storage keys are classified alike; one finding per provider (meta is a social provider, hotjar analytics).",
   "body": "<script>document.cookie='_fbp=fb.1; path=/'; localStorage.setItem('_hjSession_1','x'); sessionStorage.setItem('neutral','y');</script>",
   "expect": {"outcomes": "AFAAAN", "findings": [
     ["non_essential_storage_before_consent", "evidence", "social", ""],
     ["non_essential_storage_before_consent", "evidence", "analytics", ""]]}},

  {"name": "consent storage only", "why": "A consent-platform storage key is not non-essential storage.",
   "body": "<script>localStorage.setItem('OptanonConsent','x'); localStorage.setItem('theme','dark');</script>",
   "expect": {"outcomes": "ANAAAN", "findings": []}},

