        "case": "interaction_focus_indicator",
        "file": "tests/fixtures/detection_corpus/interaction_focus_indicator.html",
        "verdict": "needs_review",
        "selector": "button#fi-bare",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Controls with and without a visible focus indicator</title>\n<style>\n  body { font-family: sans-serif; color: #111; background: #fff; margin: 0; padding: 16px; }\n  a, button, input { display: inline-block; min-width: 44px; min-height: 44px; padding: 8px 12px; box-sizing: border-box; margin: 4px; }\n  /* Replaces the browser's focus ring with nothing: focusing changes no style. */\n  .skip { position: absolute; left: -9999px; }\n  .skip:focus { left: 16px; top: 16px; background: #fff; }\n  .bare { outline: none; border: 1px solid #767676; background: #fff; color: #111; }\n  /* An author ring on focus. */\n  .ring:focus-visible { outline: 3px solid #0050a0; outline-offset: 2px; }\n  /* No ring, but the background changes: still an indicator. */\n  .fill { outline: none; background: #fff; }\n  .fill:focus { background: #ffe58a; }\n  /* No ring, but a shadow appears. */\n  .glow { outline: none; }\n  .glow:focus { box-shadow: 0 0 0 3px #0050a0; }\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to main content</a>\n<header><p>Garden shop</p>\n<nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/shop\">Shop</a></nav></header>\n<main id=\"main\">\n  <h1>Focus indicators</h1>\n  <!-- needs_review: the focus ring is removed and nothing replaces it -->\n  <button id=\"fi-bare\" class=\"bare\" type=\"button\">Bare button</button>\n  <a id=\"fi-bare-link\" class=\"bare\" href=\"/cart\">Bare link</a>\n  <input id=\"fi-bare-input\" class=\"bare\" type=\"text\" aria-label=\"Bare field\">\n  <!-- absent: the browser's own focus ring -->\n  <button id=\"fi-default\" type=\"button\">Default ring</button>\n  <a id=\"fi-default-link\" href=\"/shop\">Default link</a>\n  <!-- absent: author-drawn indicators -->\n  <button id=\"fi-ring\" class=\"ring\" type=\"button\">Author ring</button>\n  <button id=\"fi-fill\" class=\"fill\" type=\"button\">Fill change</button>\n  <button id=\"fi-glow\" class=\"glow\" type=\"button\">Shadow</button>\n  <!-- absent: not reachable with Tab, so not a candidate -->\n  <button id=\"fi-skipped\" class=\"bare\" type=\"button\" tabindex=\"-1\">Skipped</button>\n</main>\n<footer><p>Garden shop, 2026</p></footer>\n</body>\n</html>"
