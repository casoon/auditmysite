    "file": "tests/fixtures/detection_corpus/patterns_disclosure.html",
    "verdict": "needs_review",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Disclosure/accordion pattern and focus order corpus case</title>\n</head>\n<body>\n    <main>\n        <h1>Accordion, disclosure menu, and focus order</h1>\n\n        <span role=\"link\" aria-expanded=\"true\">Non-button accordion trigger</span>\n\n        <button aria-expanded=\"true\">Accordion trigger without controls</button>\n\n        <span role=\"link\" tabindex=\"0\">Main Menu <button tabindex=\"0\">Item</button></span>\n\n        <button tabindex=\"5\">Out of order button</button>\n    </main>\n</body>\n</html>"
