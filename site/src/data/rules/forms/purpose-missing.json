        "verdict": "pass",
        "selector": "input#view-name",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <title>Input purpose: a person's name vs. the name of a thing (#658)</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n  /* #783: page shell, so the case only reports what it is about */\n  .skip, nav a { display: inline-block; padding: 12px; min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  button, input, select, textarea { min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  input[type=\"checkbox\"], input[type=\"radio\"] { width: 44px; height: 44px; }\n</style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n<header><p>Example Shop</p><nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/help\">Help</a></nav></header>\n<main id=\"main\">\n        <h1>Save the view</h1>\n\n        <!-- The name a user gives a saved grid view: not about the user -->\n        <form>\n            <label for=\"view-name\">Name</label>\n            <input id=\"view-name\" type=\"text\" placeholder=\"My view\">\n            <label for=\"project-title\">Project name</label>\n            <input id=\"project-title\" type=\"text\">\n            <label for=\"upload-target\">Dateiname</label>\n            <input id=\"upload-target\" type=\"text\">\n            <!-- \"tel\" inside \"Hotel\" is no phone field -->\n            <label for=\"stay\">Hotel</label>\n            <input id=\"stay\" type=\"text\">\n            <button type=\"submit\">Save the view</button>\n        </form>\n\n        <!-- Fields that ask for the person's name, without autocomplete -->\n        <form>\n            <label for=\"your-name\">Your name</label>\n            <input id=\"your-name\" type=\"text\">\n            <label for=\"given\">Vorname</label>\n            <input id=\"given\" type=\"text\">\n            <label for=\"phone-de\">Telefonnummer</label>\n            <input id=\"phone-de\" type=\"text\">\n            <label for=\"zip-de\">Postleitzahl</label>\n            <input id=\"zip-de\" type=\"text\">\n            <button type=\"submit\">Send</button>\n        </form>\n    </main>\n<footer><p>Example Shop, 2026</p></footer>\n</body>\n</html>"
