rm id=\"ac-twice\" action=\"/gift\" method=\"post\">\n  <p><label for=\"ac-mail1\">Email</label> <input id=\"ac-mail1\" name=\"sender\" type=\"email\" autocomplete=\"email\"></p>\n  <p><label for=\"ac-mail2\">Email for the receipt</label> <input id=\"ac-mail2\" name=\"receipt\" type=\"email\" autocomplete=\"email\"></p>\n  <p><button type=\"submit\">Send gift</button></p>\n</form>\n<form id=\"single-mail\" action=\"/quote\" method=\"post\">\n  <p><label for=\"sm-mail\">Email</label> <input id=\"sm-mail\" name=\"quote\" type=\"text\"></p>\n  <p><button type=\"submit\">Request quote</button></p>\n</form>\n</main>\n<footer><p>Example Shop, 2026</p></footer>\n\n</body>\n</html>"
