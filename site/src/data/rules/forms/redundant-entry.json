  "title": "Missing reuse of previously entered data",
  "outcome": "hint-only",
  "criterion": "3.3.7",
  "level": "A",
  "axe_id": "redundant-entry",
  "dimension": "Accessibility",
  "subcategory": "Forms & Interaction",
  "issue_class": "Weak",
  "severity": "medium",
  "user_impact": "Users must retype data they already entered, which costs time and is an extra burden especially for people with motor or cognitive impairments.",
  "technical_impact": "Form fields without an autocomplete attribute, prefilled value, or reuse option for already-captured values.",
  "source": "WCAG 2.2 SC 3.3.7 Redundant Entry",
  "applicability": "Rendered forms with text-entry fields asking for e-mail, phone, name, street address or postal code.",
  "expectation": "Needs review when one form asks for the same information two or more times\nwithout autocomplete, prefill or a \"same as\" option: whether both fields\nbelong to the same process is a human judgement. The exceptions of 3.3.7\nare not reported: confirmation fields (\"Confirm email\"), autofill tokens, a\n\"same as\" option, a value already filled in; a single request is no\nrepetition.",
  "method": "shared",
  "capabilities": [
    "dom"
  ],
