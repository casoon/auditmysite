  "capabilities": [
    "dom",
    "computed_style"
  ],
  "page_level": false,
  "failing": {
    "case": "structure_head_defects",
    "file": "tests/fixtures/detection_corpus/structure_head_defects.html",
    "verdict": "violation",
    "selector": "h2#empty-decorative",
    "html": "<!DOCTYPE html>\n<html lang=\"en\" xml:lang=\"de\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>\n    </title>\n    <style>\n        body { font: 16px/1.5 sans-serif; margin: 0 16px; }\n        a { display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; }\n        input, button { min-width: 44px; min-height: 44px; }\n        .is-hidden { display: none; }\n    </style>\n</head>\n<body>\n    <!-- A CMS template with broken head data and empty heading shells (#783):\n         lang and xml:lang name different languages, the title holds only\n         whitespace, and several headings carry no accessible name. -->\n    <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n    <header>\n        <p>Acme Hardware</p>\n    </header>\n    <nav aria-label=\"Main\">\n        <ul>\n            <li><a href=\"/\">Home</a></li>\n            <li><a href=\"/shop/\">Shop</a></li>\n        </ul>\n    </nav>\n    <main id=\"main\">\n        <h1>Product catalogue</h1>\n        <!-- Empty: no text, and the only image is decorative. -->\n        <h2 id=\"empty-decorative\"><img src=\"divider.png\" alt=\"\"></h2>\n        <p>Hand tools for every workshop.</p>\n        <!-- Named by an image's alternative text: not empty. -->\n        <h2 id=\"named-by-alt\"><img src=\"logo-tools.png\" alt=\"Tools by Acme\"></h2>\n        <p>Hammers, saws and planes.</p>\n        <!-- Named by aria-labelledby: not empty. -->\n        <h2 id=\"named-by-ref\" aria-labelledby=\"garden-label\"></h2>\n        <p id=\"garden-label\">Garden</p>\n        <!-- An ARIA heading with no name is an empty heading as well. -->\n        <div id=\"empty-aria-heading\" role=\"heading\" aria-level=\"2\"></div>\n        <p>Spades and rakes.</p>\n        <!-- Hidden and empty: not rendered, not in the outline. -->\n        <h2 id=\"hidden-empty\" class=\"is-hidden\"></h2>\n        <h2>Contact</h2>\n        <p>Call us during opening hours.</p>\n    </main>\n    <footer>\n        <p>Acme Hardware, Berlin</p>\n    </footer>\n</body>\n</html>"
  },
  "passing": {
