    "case": "display_modes_viz_static",
    "file": "tests/fixtures/detection_corpus/display_modes_viz_static.html",
    "verdict": "violation",
    "selector": "figure#globe",
    "html": "<!DOCTYPE html>\n<!-- Display-mode convention, static rules shared with a11y-rules (#699): an\n     interactive visualisation without a still image and without a caption, a\n     chart whose values are only in a sentence, and one that does it right\n     (caption, still image, table). The toggle and data-display are in place,\n     so no display/* finding is expected besides the viz/* ones. -->\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Display modes: static rules</title>\n  <script>document.documentElement.dataset.display = 'visual';</script>\n  <style>\n    [data-viz-text] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }\n    #display-toggle { min-width: 44px; min-height: 44px; }\n  </style>\n</head>\n<body>\n  <header>\n    <nav aria-label=\"Display\">\n      <select id=\"display-toggle\" data-display-toggle aria-label=\"Display\">\n        <option value=\"visual\" selected>Visual</option>\n        <option value=\"calm\">Calm</option>\n        <option value=\"text\">Text</option>\n      </select>\n    </nav>\n  </header>\n  <main>\n    <h1>Earth systems</h1>\n    <figure id=\"globe\" data-viz=\"interactive\">\n      <canvas data-viz-live width=\"300\" height=\"150\" aria-hidden=\"true\"></canvas>\n      <div data-viz-text><p>A globe showing ocean currents; drag to turn it.</p></div>\n    </figure>\n    <figure id=\"spark\" data-viz=\"chart\">\n      <svg data-viz-static aria-hidden=\"true\" width=\"120\" height=\"30\" viewBox=\"0 0 120 30\"><path d=\"M0 25 L120 5\" stroke=\"#333\" fill=\"none\"></path></svg>\n      <div data-viz-text><p>Rises from 2 to 9 over the period.</p></div>\n      <figcaption>Trend</figcaption>\n    </figure>\n    <figure id=\"good\" data-viz=\"chart\">\n      <svg data-viz-static aria-hidden=\"true\" width=\"120\" height=\"30\" viewBox=\"0 0 120 30\"><path d=\"M0 25 L120 5\" stroke=\"#333\" fill=\"none\"></path></svg>\n      <div data-viz-text>\n        <table>\n          <caption>Values</caption>\n          <tr><th scope=\"col\">Year</th><th scope=\"col\">Value</th></tr>\n          <tr><td>2000</td><td>2</td></tr>\n          <tr><td>2020</td><td>9</td></tr>\n        </table>\n      </div>\n      <figcaption>Values by year</figcaption>\n    </figure>\n  </main>\n</body>\n</html>"
  },
  "passing": {
    "case": "content_viz_hidden_panel",
    "file": "tests/fixtures/detection_corpus/content_viz_hidden_panel.html",
    "verdict": "pass",
    "selector": "figure#archived-chart",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Library in numbers: archived panel</title>\n  <script>document.documentElement.dataset.display = 'visual';</script>\n  <style>\n    html:not([data-display=\"text\"]) [data-viz-text] {\n      position: absolute; width: 1px; height: 1px; overflow: hidden;\n      clip-path: inset(50%); white-space: nowrap;\n    }\n    body > a[href=\"#main\"], #display-toggle { display: inline-block; min-width: 44px; min-height: 44px; }\n  </style>\n</head>\n<body>\n  <a href=\"#main\">Skip to main content</a>\n  <header>\n    <nav aria-label=\"Display\">\n      <label for=\"display-toggle\">Display</label>\n      <select id=\"display-toggle\" data-display-toggle>\n        <option value=\"visual\" selected>Visual</option>\n        <option value=\"calm\">Calm</option>\n        <option value=\"text\">Text</option>\n      </select>\n    </nav>\n  </header>\n  <main id=\"main\">\n    <h1>Library in numbers</h1>\n    <section aria-labelledby=\"this-year\">\n      <h2 id=\"this-year\">This year</h2>\n      <p>Figures for this year follow in spring.</p>\n    </section>\n    <section aria-labelledby=\"last-year\" hidden>\n      <h2 id=\"last-year\">Last year</h2>\n      <figure id=\"archived-chart\" data-viz=\"interactive\">\n        <canvas data-viz-live width=\"200\" height=\"100\" aria-hidden=\"true\"></canvas>\n        <div data-viz-text><p>Loans fell slightly to 14,200.</p></div>\n      </figure>\n    </section>\n  </main>\n  <footer><p>City Library, 1 Market Square</p></footer>\n</body>\n</html>"
  }
}
