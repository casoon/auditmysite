-live width=\"200\" height=\"100\" aria-hidden=\"true\"></canvas>\n      <div data-viz-text><p>Floor plan; select a room to see its seats.</p></div>\n      <div><figcaption>Floor explorer</figcaption></div>\n    </figure>\n    <viz-card></viz-card>\n    <div id=\"late-viz\"></div>\n    <script>\n      customElements.define('viz-card', class extends HTMLElement {\n        connectedCallback() {\n          this.attachShadow({ mode: 'open' }).innerHTML =\n            '<figure id=\"shadow-chart\" data-viz=\"chart\"><div data-viz-text><p>Visits rose from 200 to 310.</p></div></figure>';\n        }\n      });\n      document.getElementById('late-viz').innerHTML =\n        '<figure id=\"late-chart\" data-viz=\"chart\"><div data-viz-text><p>Members rose from 4,100 to 4,800.</p></div></figure>';\n    </script>\n  </main>\n  <footer><p>City Library, 1 Market Square</p></footer>\n</body>\n</html>"
