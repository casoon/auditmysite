    "html": "<!DOCTYPE html>\n<html lang=\"en_US\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <style>\n        body { font: 16px/1.5 sans-serif; margin: 0 16px; }\n        a { display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; }\n        input, button { min-width: 44px; min-height: 44px; }\n    </style>\n</head>\n<body>\n    <!-- An old intranet page (#783): no <title> at all, a locale-style lang\n         value (\"en_US\" uses an underscore, which BCP 47 does not allow, so\n         the primary subtag is not \"en\"), and a repeated navigation block with\n         no way to bypass it: no heading, no main landmark, no skip link. -->\n    <nav>\n        <a href=\"/\">Intranet home</a>\n        <a href=\"/staff/\">Staff directory</a>\n        <a href=\"/forms/\">Request forms</a>\n        <a href=\"/help/\">IT help desk</a>\n    </nav>\n    <!-- The only heading is hidden, so it bypasses nothing. -->\n    <h1 hidden>Intranet</h1>\n    <div class=\"content\">\n        <p>Holiday requests for next year are due by the end of the month.</p>\n        <p>Use the staff portal to submit them.</p>\n        <!-- An embedded calendar with its own title: it titles the frame\n             document, not this page. -->\n        <iframe title=\"Staff calendar\" width=\"300\" height=\"150\"\n            srcdoc=\"<!DOCTYPE html><html lang='en'><head><title>Staff calendar</title></head><body><p>No events today</p></body></html>\"></iframe>\n    </div>\n</body>\n</html>"
