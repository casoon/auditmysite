  "title": "Focusable element hidden from screen readers",
  "outcome": "automatic",
  "area": "Accessibility, Technical Robustness",
  "criterion": "4.1.2",
  "level": "A",
  "axe_id": "aria-hidden-focus",
  "severity": "high",
  "user_impact": "Keyboard users reach elements that screen readers do not announce — invisible traps.",
  "technical_impact": "aria-hidden=\"true\" on a focusable element or its ancestor.",
  "checks": [
    {
      "contract_id": "keyboard/hidden-focusable",
      "outcome": "automatic",
      "source": "WCAG 2.2 SC 4.1.2 Name, Role, Value and SC 1.3.1; WAI-ARIA 1.2 §6.7 aria-hidden (authors must not hide focusable content); HTML §6.6.3 tabindex, §6.3 inert",
      "applicability": "Rendered elements in the sequential tab order (native focusable or tabindex >= 0) that are inside, or carry, aria-hidden=\"true\".",
      "expectation": "Fails (violation, one per element) when an element that the Tab key reaches\nis hidden from the accessibility tree by aria-hidden=\"true\" on itself or an\nancestor, also across an open shadow root (aria-hidden applies to the flat\ntree): keyboard users land on something that is not announced. Passes when\nthe element is taken out of the tab order (tabindex=\"-1\"), when the hidden\nsubtree is inert, when it is not rendered, or when aria-hidden is \"false\".\nNative links and ARIA widgets with tabindex 0 count alike, as does\naria-hidden set by a script after load. Behind an open modal dialog\n(aria-modal=\"true\" or an open <dialog>) aria-hidden on the page outside the\nmodal is the ARIA dialog pattern when focus stays in the dialog; that cannot be\ndecided statically, so such an element is needs_review, not a violation.\naria-hidden on a control inside the modal itself stays a violation.",
      "method": "shared",
      "capabilities": [
        "dom",
        "computed_style"
      ],
      "page_level": false,
      "failing": {
        "case": "interaction_hidden_focusable_modal",
        "file": "tests/fixtures/detection_corpus/interaction_hidden_focusable_modal.html",
        "verdict": "violation",
        "selector": "button#hm-inside",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Hidden focusable behind an open modal</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n        a, button { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Shop</p></header>\n    <nav aria-label=\"Main\"><a href=\"/products\" aria-current=\"page\">Products</a></nav>\n    <main id=\"main\">\n        <!-- needs_review: the page behind an open modal dialog is aria-hidden on purpose -->\n        <div id=\"page-behind\" aria-hidden=\"true\">\n            <a id=\"hm-behind\" href=\"/prices\">Prices</a>\n        </div>\n        <div role=\"dialog\" aria-modal=\"true\" aria-label=\"Cookie preferences\">\n            <h1>Cookie preferences</h1>\n            <button id=\"hm-accept\" type=\"button\">Accept</button>\n            <!-- violation: aria-hidden on a control inside the modal itself -->\n            <button id=\"hm-inside\" type=\"button\" aria-hidden=\"true\">Close</button>\n        </div>\n    </main>\n    <footer><p>Imprint</p></footer>\n</body>\n</html>"
      },
      "passing": {
        "case": "interaction_hidden_focusable_modal",
        "file": "tests/fixtures/detection_corpus/interaction_hidden_focusable_modal.html",
        "verdict": "pass",
        "selector": "button#hm-accept",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Hidden focusable behind an open modal</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n        a, button { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Shop</p></header>\n    <nav aria-label=\"Main\"><a href=\"/products\" aria-current=\"page\">Products</a></nav>\n    <main id=\"main\">\n        <!-- needs_review: the page behind an open modal dialog is aria-hidden on purpose -->\n        <div id=\"page-behind\" aria-hidden=\"true\">\n            <a id=\"hm-behind\" href=\"/prices\">Prices</a>\n        </div>\n        <div role=\"dialog\" aria-modal=\"true\" aria-label=\"Cookie preferences\">\n            <h1>Cookie preferences</h1>\n            <button id=\"hm-accept\" type=\"button\">Accept</button>\n            <!-- violation: aria-hidden on a control inside the modal itself -->\n            <button id=\"hm-inside\" type=\"button\" aria-hidden=\"true\">Close</button>\n        </div>\n    </main>\n    <footer><p>Imprint</p></footer>\n</body>\n</html>"
      }
    }
  ]
