  "level": "A",
  "axe_id": "aria-hidden-focus",
  "severity": "high",
  "user_impact": "Keyboard users reach elements that screen readers do not announce — invisible traps.",
  "technical_impact": "aria-hidden=\"true\" on a focusable element or its ancestor.",
  "checks": [
    {
      "contract_id": "keyboard/hidden-focusable",
      "outcome": "automatic",
      "source": "WCAG 2.2 SC 4.1.2 Name, Role, Value and SC 1.3.1; WAI-ARIA 1.2 §6.7 aria-hidden (authors must not hide focusable content); HTML §6.6.3 tabindex, §6.3 inert",
      "applicability": "Rendered elements in the sequential tab order (native focusable or tabindex >= 0) that are inside, or carry, aria-hidden=\"true\".",
      "expectation": "Fails (violation, one per element) when an element that the Tab key reaches\nis hidden from the accessibility tree by aria-hidden=\"true\" on itself or an\nancestor, also across an open shadow root (aria-hidden applies to the flat\ntree): keyboard users land on something that is not announced. Passes when\nthe element is taken out of the tab order (tabindex=\"-1\"), when the hidden\nsubtree is inert, when it is not rendered, or when aria-hidden is \"false\".\nNative links and ARIA widgets with tabindex 0 count alike, as does\naria-hidden set by a script after load.",
      "method": "shared",
      "capabilities": [
        "dom",
        "computed_style"
      ],
      "page_level": false,
      "failing": {
        "case": "keyboard_hidden_focusable",
        "file": "tests/fixtures/detection_corpus/keyboard_hidden_focusable.html",
        "verdict": "violation",
        "selector": "a#hf-link",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Focusable under aria-hidden</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        a, button, [role=\"button\"], [tabindex] { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Shop</p></header>\n    <nav aria-label=\"Main\">\n        <a href=\"/\" aria-current=\"page\">Home</a>\n        <a href=\"/products\">Products</a>\n    </nav>\n    <main id=\"main\">\n        <h1>Order your delivery</h1>\n        <!-- violation (4.1.2): a link the Tab key reaches inside an aria-hidden container -->\n        <div aria-hidden=\"true\">\n            <a id=\"hf-link\" href=\"/help\">Delivery help</a>\n        </div>\n    </main>\n    <footer><p>Example Shop footer</p></footer>\n</body>\n</html>"
      },
      "passing": {
        "case": "keyboard_tab_order_clean",
        "file": "tests/fixtures/detection_corpus/keyboard_tab_order_clean.html",
        "verdict": "pass",
        "selector": "a#hf-minus",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Tab order without findings</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        a, button, [role=\"button\"], [tabindex] { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Shop</p></header>\n    <nav aria-label=\"Main\">\n        <a href=\"/\" aria-current=\"page\">Home</a>\n        <a href=\"/products\">Products</a>\n    </nav>\n    <main id=\"main\">\n        <h1>Order your delivery</h1>\n        <!-- absent: tabindex 0 and -1 keep the natural order -->\n        <button id=\"pt-zero\" type=\"button\" tabindex=\"0\">Edit address</button>\n        <button id=\"pt-minus\" type=\"button\" tabindex=\"-1\">Skipped by Tab</button>\n        <!-- absent: a named region in the tab order is the scrollable-region pattern -->\n        <div id=\"fnr-region\" role=\"region\" aria-label=\"Delivery terms\" tabindex=\"0\">Delivery terms.</div>\n        <!-- pass: aria-hidden content taken out of the tab order -->\n        <div aria-hidden=\"true\">\n            <a id=\"hf-minus\" href=\"/faq\" tabindex=\"-1\">FAQ</a>\n        </div>\n    </main>\n    <footer><p>Example Shop footer</p></footer>\n</body>\n</html>"
      }
    }
  ]
}
