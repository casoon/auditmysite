  "domain": "wcag",
  "title": "Positive tabindex changes the focus order",
  "outcome": "hint-only",
  "area": "Accessibility, Navigation & Operation",
  "criterion": "2.4.3",
  "level": "A",
  "axe_id": "keyboard/positive-tabindex",
  "severity": "high",
  "user_impact": "Keyboard users reach elements in an order that does not match the page layout.",
  "technical_impact": "An element has a tabindex above 0, so it moves ahead of all elements with tabindex 0 or none in the tab order regardless of its DOM position, and focus order and reading order diverge.",
  "checks": [
    {
      "contract_id": "keyboard/positive-tabindex",
      "outcome": "hint-only",
      "source": "WCAG 2.2 SC 2.4.3 Focus Order; failure F44 (tabindex creating a tab order that does not preserve meaning); HTML §6.6.3 the tabindex attribute",
      "applicability": "Rendered elements carrying a tabindex attribute that parses as an integer.",
      "expectation": "A rendered element with tabindex greater than 0 is reported once as\nneeds_review: a positive value moves it ahead of the natural order, which\nfails 2.4.3 only when the resulting order breaks meaning or operation (F44),\nand that the markup does not show. tabindex 0 and -1 keep the natural order\nand are not reported; the boundary is 1. A display:none element is in no tab\norder and is not reported. ARIA widgets (span role=button) and native\ncontrols count alike, so do elements in an open shadow root, a value set by\nscript after load, and an element rendered on one viewport only.",
      "method": "shared",
      "capabilities": [
        "dom",
        "computed_style"
      ],
      "page_level": false,
      "failing": {
        "case": "keyboard_positive_tabindex",
        "file": "tests/fixtures/detection_corpus/keyboard_positive_tabindex.html",
        "verdict": "needs_review",
        "selector": "button#pt-native",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Positive tabindex</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        a, button, [role=\"button\"], [tabindex] { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Shop</p></header>\n    <nav aria-label=\"Main\">\n        <a href=\"/\" aria-current=\"page\">Home</a>\n        <a href=\"/products\">Products</a>\n    </nav>\n    <main id=\"main\">\n        <h1>Order your delivery</h1>\n        <!-- needs_review (2.4.3, F44): a positive tabindex moves the control ahead of the natural order -->\n        <button id=\"pt-native\" type=\"button\" tabindex=\"2\">Choose date</button>\n    </main>\n    <footer><p>Example Shop footer</p></footer>\n</body>\n</html>"
      },
      "passing": {
        "case": "keyboard_tab_order_clean",
        "file": "tests/fixtures/detection_corpus/keyboard_tab_order_clean.html",
        "verdict": "absent",
        "selector": "button#pt-zero",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Tab order without findings</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        a, button, [role=\"button\"], [tabindex] { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Shop</p></header>\n    <nav aria-label=\"Main\">\n        <a href=\"/\" aria-current=\"page\">Home</a>\n        <a href=\"/products\">Products</a>\n    </nav>\n    <main id=\"main\">\n        <h1>Order your delivery</h1>\n        <!-- absent: tabindex 0 and -1 keep the natural order -->\n        <button id=\"pt-zero\" type=\"button\" tabindex=\"0\">Edit address</button>\n        <button id=\"pt-minus\" type=\"button\" tabindex=\"-1\">Skipped by Tab</button>\n        <!-- absent: a named region in the tab order is the scrollable-region pattern -->\n        <div id=\"fnr-region\" role=\"region\" aria-label=\"Delivery terms\" tabindex=\"0\">Delivery terms.</div>\n        <!-- pass: aria-hidden content taken out of the tab order -->\n        <div aria-hidden=\"true\">\n            <a id=\"hf-minus\" href=\"/faq\" tabindex=\"-1\">FAQ</a>\n        </div>\n    </main>\n    <footer><p>Example Shop footer</p></footer>\n</body>\n</html>"
      }
    }
  ]
}
