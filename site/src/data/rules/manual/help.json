 <footer><p>Example Club footer</p></footer>\n    <script>\n        // manual/motion-actuation: shake to refresh the photos\n        window.addEventListener('devicemotion', function (event) {\n            if (event.acceleration && event.acceleration.x > 20) { location.reload(); }\n        });\n    </script>\n</body>\n</html>"
