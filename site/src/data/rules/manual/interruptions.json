        "verdict": "needs_review",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Cookie consent dialog</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        a, button { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n        .panel { border: 1px solid #333; padding: 16px; margin: 16px 0; }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example Garden</p></header>\n    <nav aria-label=\"Main\">\n        <a href=\"/\" aria-current=\"page\">Home</a>\n        <a href=\"/plants\">Plants</a>\n    </nav>\n    <main id=\"main\">\n        <h1>Summer pruning</h1>\n        <p>Cut back lavender after flowering.</p>\n\n        <!-- needs_review (2.1.2): a native dialog that a script opens with showModal() after load -->\n        <dialog id=\"dlg-native-modal\" aria-labelledby=\"dlg-native-modal-title\">\n            <h2 id=\"dlg-native-modal-title\">Cookie settings</h2>\n            <p>We only use cookies that the site needs.</p>\n            <button type=\"button\">Accept</button>\n            <button type=\"button\">Settings</button>\n        </dialog>\n    </main>\n    <!-- Outside every landmark, but inert behind the open modal: nobody reaches it, so it is\n         not content-outside (#783). -->\n    <div class=\"promo\"><p>Seeds half price this week.</p></div>\n    <footer><p>Example Garden footer</p></footer>\n\n    <script>\n        document.getElementById('dlg-native-modal').showModal();\n    </script>\n</body>\n</html>"
