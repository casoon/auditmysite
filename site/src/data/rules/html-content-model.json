           <tr><td>Battery 2 Ah</td><td>39 EUR</td></tr>\n                <tr><td>Charger</td><td>29 EUR</td></tr>\n            </tbody>\n        </table>\n    </main>\n    <footer>\n        <p>Acme Hardware, Berlin</p>\n    </footer>\n</body>\n</html>"
  },
