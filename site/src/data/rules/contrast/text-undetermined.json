        "verdict": "needs_review",
        "selector": "p#covered",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Contrast under a fixed banner</title>\n<style>\n  body { margin: 0; background: #ffffff; color: #111111; }\n  #banner { position: fixed; top: 0; left: 0; width: 100%; height: 110px; margin: 0;\n            background: #ffffff; color: #111111; border-bottom: 2px solid #111111; z-index: 10; }\n  #covered { margin: 0; padding-top: 30px; color: #111111; }\n  main { margin-top: 160px; padding: 0 8px; }\n</style>\n</head>\n<body>\n<header>\n  <!-- A fixed banner covers the next paragraph: its contrast cannot be\n       determined with the overlay open, which is a review, not a pass. -->\n  <p id=\"banner\">We use cookies to run this shop.</p>\n  <p id=\"covered\">Opening hours: Monday to Friday, 9 to 18.</p>\n</header>\n<main id=\"main\">\n  <h1>Text behind a fixed overlay</h1>\n  <p id=\"solid\">This paragraph sits on a solid white background.</p>\n</main>\n<footer><p>Footer text</p>\n  <a href=\"#main\" style=\"display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; padding: 0 8px\">Skip to main content</a>\n  <nav aria-label=\"Main\"><a href=\"#main\" aria-current=\"page\" style=\"display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; padding: 0 8px\">Overview</a></nav>\n</footer>\n</body>\n</html>"
