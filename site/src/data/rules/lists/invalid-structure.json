    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Reading lists with broken structure</title>\n    <style>\n        nav a, .skip-link { display: inline-block; min-width: 44px; min-height: 44px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip-link\" href=\"#main\">Skip to main content</a>\n    <header>\n        <p>City Library</p>\n        <nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/catalogue\">Catalogue</a> <a href=\"/visit\">Visit</a></nav>\n    </header>\n    <main id=\"main\">\n        <h1>Reading lists</h1>\n        <h2>Genres</h2>\n        <ul id=\"genres\">\n            <li>Crime</li>\n            <div id=\"stray-genre\">Poetry</div>\n            <li>History</li>\n        </ul>\n        <h2>Steps to join</h2>\n        <ol id=\"join-steps\"></ol>\n        <h2>Branches</h2>\n        <div role=\"list\" id=\"branch-list\">\n            <div role=\"listitem\">North branch</div>\n            <span id=\"stray-branch\">South branch</span>\n        </div>\n        <div role=\"list\" id=\"empty-aria-list\"></div>\n        <h2>Glossary</h2>\n        <dl id=\"glossary\">\n            <dt id=\"term-alone\">Interlibrary loan</dt>\n        </dl>\n        <div role=\"term\" id=\"aria-term-alone\">Reservation</div>\n        <h2>Notices</h2>\n        <div class=\"notice\"><li id=\"orphan-item\">The north branch is closed on Monday.</li></div>\n        <div role=\"listitem\" id=\"orphan-aria-item\">Returns are free of charge.</div>\n        <h2>Archived lists</h2>\n        <ul id=\"hidden-broken\" hidden><p>Old genre list</p></ul>\n        <ol id=\"styled-away\" style=\"display: none\"></ol>\n        <ul id=\"aria-hidden-broken\" aria-hidden=\"true\"><p>Decorative bullet strip</p></ul>\n        <h2>Widget lists</h2>\n        <shelf-list></shelf-list>\n        <iframe id=\"frame-lists\" title=\"Branch news\" style=\"width:400px;height:120px;border:0\" srcdoc=\"<!DOCTYPE html><html lang=&quot;en&quot;><head><title>Branch news</title></head><body><ul id=&quot;frame-list&quot;><li>North</li><p id=&quot;frame-stray&quot;>South</p></ul></body></html>\"></iframe>\n        <div id=\"late-list\"></div>\n        <script>\n            customElements.define('shelf-list', class extends HTMLElement {\n                connectedCallback() {\n                    this.attachShadow({ mode: 'open' }).innerHTML =\n                        '<ul id=\"shadow-shelf\"><li>Atlas</li><p id=\"shadow-stray\">Maps</p></ul>';\n                }\n            });\n            document.getElementById('late-list').innerHTML =\n                '<ul id=\"late-empty\"></ul><ol id=\"late-mixed\"><li>Atlas</li><div>Maps</div></ol>';\n        </script>\n    </main>\n    <footer><p>City Library, 1 Market Square</p></footer>\n</body>\n</html>"
