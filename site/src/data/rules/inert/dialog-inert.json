  "user_impact": "Screen reader and keyboard users cannot reliably access dialogs, popovers, or disabled regions.",
  "technical_impact": "Broken popovertarget references, unnamed surfaces, or active focus inside inert regions.",
  "checks": [
    {
      "contract_id": "inert/dialog-inert",
      "outcome": "automatic",
      "source": "WCAG 2.2 SC 2.1.1 Keyboard and SC 4.1.2 Name, Role, Value; HTML Living Standard, the inert attribute and the dialog element",
      "applicability": "Dialogs (open <dialog>, role dialog/alertdialog) that are rendered (Rendered scope: aria-hidden does not hide them from sight).",
      "expectation": "Fails for an open native <dialog> that is inert itself or through an ancestor: it is shown\nbut cannot be focused, operated or perceived by assistive technology. For role=dialog the markup\ncannot tell an open dialog from a closed one, so review. Closed dialogs, dialogs not rendered, and\ninert background content next to a dialog pass.",
      "method": "shared",
      "capabilities": [
        "dom",
        "computed_style"
      ],
      "page_level": false,
      "failing": {
        "case": "aria_dialogs_live_broken",
        "file": "tests/fixtures/detection_corpus/aria_dialogs_live_broken.html",
        "verdict": "violation",
        "selector": "dialog#survey-dlg",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shopping cart - Example shop</title>\n</head>\n<body>\n    <header>\n        <p>Example shop</p>\n    </header>\n    <main>\n        <h1>Shopping cart</h1>\n\n        <!-- status/live-overridden: the cart status is switched off -->\n        <div id=\"cart-status\" role=\"status\" aria-live=\"off\">2 items in your cart</div>\n        <!-- status/live-overridden (review): urgency changed, still announced -->\n        <div id=\"stock-alert\" role=\"alert\" aria-live=\"polite\">Only 1 left in stock</div>\n        <output id=\"total\" aria-live=\"assertive\">Total: 59 EUR</output>\n\n        <!-- dialog/name-missing and dialog/modal-unmarked: unnamed custom\n             dialog without aria-modal -->\n        <div id=\"coupon-dlg\" role=\"dialog\">\n            <p>Enter your coupon code.</p>\n            <button type=\"button\" id=\"coupon-ok\">Apply</button>\n        </div>\n\n        <!-- dialog/name-missing and dialog/focusable-missing: open native\n             dialog without a name and without anything to focus -->\n        <dialog open id=\"saved-dlg\">\n            <p>Your cart was saved.</p>\n        </dialog>\n\n        <!-- dialog/focusable-missing: named alert dialog, nothing to focus -->\n        <div id=\"timeout-dlg\" role=\"alertdialog\" aria-modal=\"true\" aria-labelledby=\"timeout-title\">\n            <h2 id=\"timeout-title\">Session ending</h2>\n            <p>Your session ends in one minute.</p>\n        </div>\n\n        <!-- inert/dialog-inert: an open dialog that is inert -->\n        <dialog open inert id=\"survey-dlg\" aria-label=\"Quick survey\">\n            <p>How was your visit?</p>\n            <button type=\"button\" id=\"survey-ok\">Answer</button>\n        </dialog>\n        <!-- inert/dialog-inert (review): custom dialog under an inert ancestor;\n             without styles it may as well be a closed one -->\n        <div inert>\n            <div id=\"help-dlg\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Help\">\n                <button type=\"button\" id=\"help-close\">Close</button>\n            </div>\n        </div>\n    </main>\n    <footer>\n        <p>Example shop</p>\n    </footer>\n</body>\n</html>"
      },
      "passing": {
        "case": "aria_dialogs_live_valid",
        "file": "tests/fixtures/detection_corpus/aria_dialogs_live_valid.html",
        "verdict": "pass",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shopping cart - Example shop</title>\n</head>\n<body>\n    <header>\n        <p>Example shop</p>\n    </header>\n    <main>\n        <h1>Shopping cart</h1>\n\n        <!-- Live regions with their default urgency, stated or implicit; a\n             log may change its urgency -->\n        <div id=\"cart-status\" role=\"status\" aria-live=\"polite\">2 items in your cart</div>\n        <div id=\"stock-alert\" role=\"alert\">Only 1 left in stock</div>\n        <output id=\"total\">Total: 59 EUR</output>\n        <div id=\"activity\" role=\"log\" aria-live=\"assertive\">Coupon applied.</div>\n        <!-- aria-live off on an element that is no live region role -->\n        <div id=\"ticker\" aria-live=\"off\">Prices include VAT.</div>\n\n        <!-- Named modal dialog with a control, named by aria-labelledby -->\n        <div id=\"coupon-dlg\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"coupon-title\">\n            <h2 id=\"coupon-title\">Coupon</h2>\n            <button type=\"button\" id=\"coupon-ok\">Apply</button>\n        </div>\n\n        <!-- Open native dialog named by aria-label, with a control -->\n        <dialog open id=\"saved-dlg\" aria-label=\"Cart saved\">\n            <p>Your cart was saved.</p>\n            <button type=\"button\" id=\"saved-ok\">OK</button>\n        </dialog>\n\n        <!-- Closed native dialogs are not presented: no name needed, inert is\n             harmless -->\n        <dialog id=\"closed-dlg\"><p>Not shown.</p></dialog>\n        <dialog id=\"closed-inert-dlg\" inert><p>Not shown either.</p></dialog>\n\n        <!-- Inert background content next to the dialog is the intended use -->\n        <div id=\"background\" inert>\n            <p>Recommended products</p>\n        </div>\n    </main>\n    <footer>\n        <p>Example shop</p>\n    </footer>\n</body>\n</html>"
      }
    }
  ]
}
