  "failing": {
    "case": "svg_graphics_role_no_name",
    "file": "tests/fixtures/detection_corpus/svg_graphics_role_no_name.html",
    "verdict": "violation",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>SVG with explicit graphics role and no accessible name</title>\n</head>\n<body>\n    <main>\n        <h1>SVG with role=\"graphics-document\" and no title/aria-label</h1>\n        <svg role=\"graphics-document\" width=\"120\" height=\"80\" viewBox=\"0 0 120 80\">\n            <rect x=\"0\" y=\"0\" width=\"120\" height=\"80\" fill=\"steelblue\"></rect>\n        </svg>\n    </main>\n</body>\n</html>"
  },
  "passing": {
    "case": "aria_names_valid",
    "file": "tests/fixtures/detection_corpus/aria_names_valid.html",
    "verdict": "pass",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Media player - Example radio</title>\n</head>\n<body>\n    <header>\n        <p>Example radio</p>\n    </header>\n    <main>\n        <h1>Live stream</h1>\n\n        <!-- Every alternative name source: aria-label, aria-labelledby,\n             <label>, title on a native field, content -->\n        <div id=\"volume\" role=\"slider\" tabindex=\"0\" aria-label=\"Volume\" aria-valuenow=\"7\" aria-valuemin=\"0\" aria-valuemax=\"10\"></div>\n        <div id=\"autoplay\" role=\"switch\" tabindex=\"0\" aria-checked=\"false\" aria-labelledby=\"autoplay-label\"></div>\n        <span id=\"autoplay-label\">Autoplay</span>\n        <label for=\"station\">Station</label>\n        <input id=\"station\" type=\"text\">\n        <input id=\"search\" type=\"search\" title=\"Search stations\">\n        <div id=\"genre\" role=\"radiogroup\" aria-label=\"Genre\">\n            <div role=\"radio\" id=\"genre-jazz\" tabindex=\"0\" aria-checked=\"true\">Jazz</div>\n            <div role=\"radio\" id=\"genre-pop\" tabindex=\"-1\" aria-checked=\"false\">Pop</div>\n        </div>\n\n        <!-- One-character names that are letters or digits, and a symbol\n             from content rather than from an attribute -->\n        <button type=\"button\" id=\"channel-1\" aria-label=\"1\">1</button>\n        <button type=\"button\" id=\"umlaut\" aria-label=\"&#x00C4;\">&#x00C4;</button>\n        <button type=\"button\" id=\"next-arrow\">&#x2192;</button>\n\n        <!-- Title only adds to a visible name -->\n        <button type=\"button\" id=\"share\" title=\"Opens the share dialog\">Share</button>\n\n        <!-- Name contains the visible label; a symbol label is exempt -->\n        <button type=\"button\" id=\"play\" aria-label=\"Play live stream\">Play</button>\n        <a href=\"/notes#fn1\" id=\"fn-ref\" aria-label=\"Footnote 1\"><sup>&#x00B9;</sup></a>\n\n        <!-- Description adds information beyond the name -->\n        <button type=\"button\" id=\"mute\" aria-describedby=\"mute-desc\">Mute</button>\n        <span id=\"mute-desc\" hidden>Silences the stream until you unmute it</span>\n\n        <!-- Named summary, also through aria-label on an icon-only summary -->\n        <details id=\"lyrics\">\n            <summary id=\"lyrics-summary\">Lyrics</summary>\n            <p>No lyrics available.</p>\n        </details>\n        <details id=\"credits\">\n            <summary id=\"credits-summary\" aria-label=\"Credits\"><span aria-hidden=\"true\">&#x2139;</span></summary>\n            <p>Produced by Example radio.</p>\n        </details>\n\n        <!-- SVGs: named by title, by aria-label, decorative, and an icon inside\n             a named button -->\n        <svg id=\"cover\" role=\"img\" width=\"120\" height=\"120\" viewBox=\"0 0 120 120\">\n            <title>Album cover: Blue Nights</title>\n            <rect width=\"120\" height=\"120\" fill=\"#335\"></rect>\n        </svg>\n        <svg id=\"logo\" role=\"img\" aria-label=\"Example radio logo\" width=\"40\" height=\"40\"><circle cx=\"20\" cy=\"20\" r=\"18\"></circle></svg>\n        <svg id=\"divider\" role=\"presentation\" width=\"200\" height=\"4\"><path d=\"M0 2 L200 2\" stroke=\"#000\"></path></svg>\n        <button type=\"button\" id=\"like\"><svg id=\"like-icon\" width=\"16\" height=\"16\"><circle cx=\"8\" cy=\"8\" r=\"6\"></circle></svg> Like</button>\n    </main>\n    <footer>\n        <p>Example radio</p>\n    </footer>\n</body>\n</html>"
  }
}
