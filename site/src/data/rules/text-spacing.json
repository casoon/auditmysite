  "applicability": "Rendered elements with text that clip their own content (overflow: hidden) in the top document.",
  "expectation": "Fails when applying the 1.4.12 minimums (line height 1.5, paragraph spacing\n2em, letter spacing 0.12em, word spacing 0.16em) makes a container clip text\nit did not clip before: a fixed-height badge (20px at line-height 1.2) or a\nfixed-width, nowrap label. Content clipped already before the change\n(teasers cut by design, the 1x1 visually-hidden pattern) is not caused by\nspacing and not reported. A container exactly as tall as one line at 1.5\n(24px) still fits; one that grows (min-height) or whose fixed height a\nscript removes after load passes. The first newly clipped element is\nreported (one finding per page and viewport). A page whose probe cannot run\nis a technical failure, not a pass.",
  "method": "page",
  "capabilities": [
    "dom",
    "computed_style",
    "geometry"
  ],
  "page_level": false,
  "failing": {
    "case": "visual_text_spacing_letter",
    "file": "tests/fixtures/detection_corpus/visual_text_spacing_letter.html",
    "verdict": "violation",
    "selector": "span#chip",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Button label clipped when letter spacing grows</title>\n<style>\n  body { color: #111111; background: #ffffff; font-size: 16px; }\n  /* 13 monospace characters (7.8em) fit into 8em on one line; with 0.12em\n     letter spacing and 0.16em word spacing they no longer do. */\n  #chip { display: inline-block; width: 8em; white-space: nowrap; overflow: hidden;\n          font-family: monospace; font-size: 16px; line-height: 2; vertical-align: top; }\n</style>\n</head>\n<body>\n<header>\n  <a href=\"#main\" style=\"display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; padding: 0 8px\">Skip to main content</a>\n  <p>Shop</p>\n  <nav aria-label=\"Main\"><a href=\"#main\" aria-current=\"page\" style=\"display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; padding: 0 8px\">Overview</a></nav>\n</header>\n<main id=\"main\">\n  <h1>Garden chairs</h1>\n  <p><span id=\"chip\">Add to basket</span></p>\n</main>\n<footer><p>Footer text</p></footer>\n</body>\n</html>"
  },
  "passing": {
    "case": "visual_text_spacing_ok",
    "file": "tests/fixtures/detection_corpus/visual_text_spacing_ok.html",
    "verdict": "pass",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Containers that keep their text at larger spacing</title>\n<style>\n  body { color: #111111; background: #ffffff; font-size: 16px; }\n  /* Grows with its content. */\n  #badge { min-height: 20px; line-height: 1.2; border: 1px solid #111111; padding: 0 4px; }\n  /* Threshold: exactly one line at line-height 1.5 (24px) still fits. */\n  #fit { height: 24px; line-height: 1.2; overflow: hidden; }\n  /* Already cut off before any spacing change: not caused by spacing. */\n  #preclipped { height: 10px; overflow: hidden; }\n  /* Dynamic: fixed height removed by a script after load. */\n  #late { height: 20px; line-height: 1.2; overflow: hidden; }\n</style>\n</head>\n<body>\n<header>\n  <a href=\"#main\" style=\"display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; padding: 0 8px\">Skip to main content</a>\n  <p>Shop</p>\n  <nav aria-label=\"Main\"><a href=\"#main\" aria-current=\"page\" style=\"display: inline-block; min-width: 44px; min-height: 44px; line-height: 44px; padding: 0 8px\">Overview</a></nav>\n</header>\n<main id=\"main\">\n  <h1>Garden chairs</h1>\n  <div id=\"badge\">Free delivery on all orders</div>\n  <div id=\"fit\">In stock</div>\n  <div id=\"preclipped\">Teaser text that is cut by design and expands on click.</div>\n  <div id=\"late\">Assembly takes ten minutes</div>\n</main>\n<footer><p>Footer text</p></footer>\n<script>\n  window.addEventListener('load', function () {\n    document.getElementById('late').style.height = 'auto';\n  });\n</script>\n</body>\n</html>"
  }
