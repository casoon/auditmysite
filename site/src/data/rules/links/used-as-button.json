{
  "id": "links/used-as-button",
  "url": "https://casoon.github.io/auditmysite/rules/links/used-as-button/",
  "title": "Link used as a button substitute without a matching role",
  "outcome": "hint-only",
  "criterion": "4.1.2",
  "level": "A",
  "axe_id": "link-as-button",
  "dimension": "Accessibility",
  "subcategory": "Technical Robustness",
  "issue_class": "Invalid",
  "severity": "low",
  "user_impact": "Assistive technologies announce the element as a link even though it behaves like a button — keyboard users expect the wrong interaction.",
  "technical_impact": "<a href=\"#\">/<a href=\"javascript:...\"> with onclick, without role=\"button\".",
  "source": "WCAG 2.2 SC 4.1.2 Name, Role, Value; HTML a element (hyperlink semantics)",
  "applicability": "Rendered a elements with onclick and an href that leads nowhere (empty, #, javascript:).",
  "expectation": "Needs review when such a link triggers an action instead of navigating: it\nis announced as a link and does not react to Space; a button belongs there.\nWhether the handler navigates after all is not in the markup, so never a\nconfirmed violation. role=button on the element states its role and is not\nreported; a link with a real target and an onclick (tracking) is not\nreported.",
  "method": "shared",
  "capabilities": [
    "dom"
  ],
  "page_level": false,
