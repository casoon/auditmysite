    "file": "tests/fixtures/detection_corpus/forms_context.html",
    "verdict": "needs_review",
    "selector": "button#ctx-autofocus-btn",
    "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Catalogue</title>\n<style>\n  body { font-family: sans-serif; color: #222; background: #fff; line-height: 1.5; margin: 0 16px; }\n  a { color: #0050a0; }\n  .skip, nav a, .solo { display: inline-block; padding: 12px; min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  button, input, select, textarea, [role=\"button\"], [role=\"textbox\"], [role=\"radio\"], [role=\"link\"], [role=\"searchbox\"] {\n    display: inline-block; min-height: 44px; min-width: 44px; box-sizing: border-box; font-size: 1rem; }\n  input[type=\"checkbox\"], input[type=\"radio\"] { width: 44px; height: 44px; }\n  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to main content</a>\n<header><p>Example Shop</p>\n<nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/help\">Help</a></nav>\n</header>\n<main id=\"main\">\n<h1>Catalogue</h1>\n<!-- G2 #783: change handlers that navigate or submit (F36, F37), a handler that only filters content, a handler that calls a navigating function, focus handlers on non-interactive elements, autofocus (3.2.1, 3.2.2). -->\n<form id=\"ctx-form\" action=\"/catalogue\" method=\"get\">\n  <p><label for=\"ctx-jump\">Jump to section</label>\n  <select id=\"ctx-jump\" name=\"jump\" onchange=\"location.href = this.value\"><option value=\"#bikes\">Bikes</option><option value=\"#helmets\">Helmets</option></select></p>\n  <fieldset><legend>Delivery speed</legend>\n    <label><input type=\"radio\" name=\"speed\" id=\"ctx-radio-submit\" value=\"x\" onchange=\"this.form.submit()\"> Express</label>\n    <label><input type=\"radio\" name=\"speed\" id=\"ctx-radio-plain\" value=\"s\"> Standard</label>\n  </fieldset>\n  <p><label for=\"ctx-filter\">Show colours</label>\n  <select id=\"ctx-filter\" name=\"colour\" onchange=\"filterList(this.value)\"><option value=\"all\">All</option><option value=\"red\">Red</option><option value=\"blue\">Blue</option></select></p>\n  <ul id=\"colour-list\"><li data-c=\"red\">Red bike</li><li data-c=\"blue\">Blue bike</li></ul>\n  <p><label for=\"ctx-called\">Open category</label>\n  <select id=\"ctx-called\" name=\"category\" onchange=\"goTo(this.value)\"><option value=\"/bikes\">Bikes</option><option value=\"/helmets\">Helmets</option></select></p>\n  <p><label for=\"ctx-plain\">Gift wrap</label> <select id=\"ctx-plain\" name=\"wrap\"><option>No</option><option>Yes</option></select></p>\n  <p><label for=\"ctx-focus-input\">Quantity</label> <input id=\"ctx-focus-input\" name=\"qty\" type=\"number\" onfocus=\"this.select()\"></p>\n  <p><label for=\"ctx-autofocus-input\">Search the catalogue</label> <input id=\"ctx-autofocus-input\" name=\"q\" type=\"text\" autofocus></p>\n  <p><button type=\"submit\">Apply</button></p>\n</form>\n<p><label for=\"ctx-language\">Language</label> <select id=\"ctx-language\"><option>English</option><option>Deutsch</option></select></p>\n<div id=\"ctx-focus-div\" class=\"solo\" tabindex=\"0\" onfocus=\"document.getElementById('promo').hidden = false\">Spring promotion</div>\n<p id=\"promo\" hidden>Ten percent off all helmets.</p>\n<p><span id=\"ctx-focus-aria\" role=\"button\" tabindex=\"0\" onfocus=\"this.setAttribute('aria-describedby', 'promo')\">Size guide</span></p>\n<p><a class=\"solo\" id=\"ctx-focus-link\" href=\"/sale\" onfocus=\"this.title = 'Opens the sale'\">Sale items</a></p>\n<p><button id=\"ctx-autofocus-btn\" type=\"button\" autofocus>Continue shopping</button></p>\n<p><span id=\"ctx-autofocus-aria\" role=\"searchbox\" contenteditable=\"true\" tabindex=\"0\" aria-label=\"Quick search\" autofocus></span></p>\n</main>\n<footer><p>Example Shop, 2026</p></footer>\n<script>\n  function filterList(value) {\n    document.querySelectorAll('#colour-list li').forEach(function (li) {\n      li.hidden = value !== 'all' && li.dataset.c !== value;\n    });\n  }\n  function goTo(url) { window.location.assign(url); }\n</script>\n</body>\n</html>"
  },
