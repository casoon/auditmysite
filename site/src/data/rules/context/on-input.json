        "verdict": "pass",
        "selector": "select#filter-preset",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <title>On input: content updates vs. context changes (#657)</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n  /* #783: page shell, so the case only reports what it is about */\n  .skip, nav a { display: inline-block; padding: 12px; min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  button, input, select, textarea { min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  input[type=\"checkbox\"], input[type=\"radio\"] { width: 44px; height: 44px; }\n</style>\n    <script>\n        function applySort(value) { document.getElementById('out').textContent = 'Sorted by ' + value; }\n        function goTo(value) { window.location.href = value; }\n    </script>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n<header><p>Example Shop</p><nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/help\">Help</a></nav></header>\n<main id=\"main\">\n        <h1>Grid options</h1>\n\n        <!-- Updates the grid next to it via a script listener: no context change -->\n        <label for=\"filter-preset\">Filter preset</label>\n        <select id=\"filter-preset\">\n            <option>All</option>\n            <option>Active</option>\n        </select>\n\n        <!-- Inline handler that only updates content: at most needs review -->\n        <label for=\"sort-preset\">Sort preset</label>\n        <select id=\"sort-preset\" onchange=\"applySort(this.value)\">\n            <option>Name</option>\n            <option>Date</option>\n        </select>\n\n        <!-- Name suggests navigation, effect unknown: needs review, no violation -->\n        <label for=\"grid-language\">Language</label>\n        <select id=\"grid-language\">\n            <option>English</option>\n            <option>Deutsch</option>\n        </select>\n\n        <!-- Handler navigates via a called function: change of context -->\n        <label for=\"jump\">Jump to page</label>\n        <select id=\"jump\" onchange=\"goTo(this.value)\">\n            <option value=\"#a\">Page A</option>\n            <option value=\"#b\">Page B</option>\n        </select>\n\n        <!-- Handler submits the form: change of context -->\n        <form action=\"#submitted\">\n            <label for=\"per-page\">Rows per page</label>\n            <select id=\"per-page\" name=\"per_page\" onchange=\"this.form.submit()\">\n                <option>10</option>\n                <option>50</option>\n            </select>\n        </form>\n\n        <!-- Not submit buttons: \"go\" inside \"Google\"/\"category\"/\"logo\" must not\n             suppress the review for the language select above -->\n        <button type=\"button\">Sign in with Google</button>\n        <button type=\"button\">Category</button>\n        <button type=\"button\">Logo</button>\n\n        <p id=\"out\"></p>\n    </main>\n<footer><p>Example Shop, 2026</p></footer>\n</body>\n</html>"
