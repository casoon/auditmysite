te, true); v.setUint32(28, rate * 2, true); v.setUint16(32, 2, true);\n    v.setUint16(34, 16, true); str(36, 'data'); v.setUint32(40, n * 2, true);\n    for (var i = 0; i < n; i++) v.setInt16(44 + i * 2, Math.round(Math.sin(2 * Math.PI * hz * i / rate) * 12000), true);\n    return URL.createObjectURL(new Blob([buf], { type: 'audio/wav' }));\n  }\n  document.querySelectorAll('audio[data-seconds]').forEach(function (a) {\n    a.src = wav(Number(a.dataset.seconds), Number(a.dataset.hz));\n  });\n</script>\n</body>\n</html>"
