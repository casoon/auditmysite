    "verdict": "needs_review",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <title>Background audio, contrast, spacing, reflow, and obscured focus corpus case</title>\n</head>\n<body>\n    <main>\n        <h1>Background audio, non-text contrast, text spacing, reflow, obscured focus</h1>\n\n        <audio autoplay src=\"/bg.mp3\"></audio>\n\n        <label>\n            Subscribe\n            <input type=\"checkbox\" style=\"appearance: none; -webkit-appearance: none; width: 20px; height: 20px; background: #ffffff; border: 1px solid #f6f6f6;\">\n        </label>\n\n        <div style=\"width: 200px; height: 80px; overflow: hidden; font-size: 16px; line-height: 1.2;\">\n            This line of text just barely fits inside the box at normal spacing but not at wider spacing\n        </div>\n\n        <div style=\"width: 900px; white-space: nowrap;\">\n            This is a very long line of unbroken text forced into a fixed nine-hundred-pixel wide container that will not wrap and therefore forces horizontal scrolling once the viewport narrows to three hundred twenty pixels.\n        </div>\n\n        <a href=\"/contact\" style=\"position: fixed; bottom: 10px; left: 10px; min-width: 44px; min-height: 44px;\">Contact us</a>\n        <div style=\"position: fixed; bottom: 0; left: 0; width: 100%; height: 60px; background: #333;\"></div>\n    </main>\n</body>\n</html>"
  },
