        "verdict": "violation",
        "selector": "table#bold-row",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Branch opening hours</title>\n    <style>\n        nav a, .skip-link { display: inline-block; min-width: 44px; min-height: 44px; }\n        .head-row td { font-weight: 700; }\n    </style>\n</head>\n<body>\n    <a class=\"skip-link\" href=\"#main\">Skip to main content</a>\n    <header>\n        <p>City Library</p>\n        <nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/catalogue\">Catalogue</a> <a href=\"/visit\">Visit</a></nav>\n    </header>\n    <main id=\"main\">\n        <h1>Branch opening hours</h1>\n        <!-- F91: the first row is a header row made of bold <td> cells, more rows follow,\n             and the table has no <th> at all: the visual headers are not marked up. -->\n        <table id=\"bold-row\">\n            <caption>Opening hours by branch</caption>\n            <tr><td><b>Branch</b></td><td><strong>Weekdays</strong></td></tr>\n            <tr><td>North</td><td>9:00 to 18:00</td></tr>\n            <tr><td>South</td><td>10:00 to 16:00</td></tr>\n        </table>\n        <!-- Bold only through the stylesheet: the markup does not show the header row,\n             so this stays a review. -->\n        <table id=\"styled-row\">\n            <caption>Holiday hours by branch</caption>\n            <tr class=\"head-row\"><td>Branch</td><td>Holidays</td></tr>\n            <tr><td>North</td><td>Closed</td></tr>\n            <tr><td>South</td><td>10:00 to 14:00</td></tr>\n        </table>\n    </main>\n    <footer><p>City Library, 1 Market Square</p></footer>\n</body>\n</html>"
      },
