    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Library statistics</title>\n    <style>\n        nav a, .skip-link { display: inline-block; min-width: 44px; min-height: 44px; }\n    </style>\n</head>\n<body>\n    <a class=\"skip-link\" href=\"#main\">Skip to main content</a>\n    <header>\n        <p>City Library</p>\n        <nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/catalogue\">Catalogue</a> <a href=\"/visit\">Visit</a></nav>\n    </header>\n    <main id=\"main\">\n        <h1>Library statistics</h1>\n        <table id=\"prices\">\n            <caption>Copy and print prices</caption>\n            <thead><tr><th scope=\"col\" id=\"price-item\">Item</th><th scope=\"col\" id=\"price-cost\">Cost</th></tr></thead>\n            <tbody>\n                <tr><td headers=\"price-item\">Black and white page</td><td headers=\"price-cost\">0.10</td></tr>\n                <tr><td headers=\"price-item\">Colour page</td><td headers=\"price-item price-cost\">0.50</td></tr>\n            </tbody>\n        </table>\n        <h2 id=\"hours-heading\">Opening hours</h2>\n        <table id=\"hours\" aria-labelledby=\"hours-heading\">\n            <tr><th scope=\"row\">Monday</th><td>9:00 to 18:00</td></tr>\n            <tr><th scope=\"row\">Sunday</th><td></td></tr>\n        </table>\n        <table id=\"minimal\" aria-label=\"Late returns\">\n            <tr><th id=\"late-head\">Late returns this week</th><td></td></tr>\n        </table>\n        <table id=\"layout\" role=\"presentation\">\n            <tr><td>Address: 1 Market Square</td><td>Phone: 555 0100</td></tr>\n        </table>\n        <div role=\"table\" id=\"aria-branches\" aria-label=\"Branches\">\n            <div role=\"row\"><div role=\"columnheader\">Branch</div><div role=\"columnheader\">Status</div></div>\n            <div role=\"row\"><div role=\"cell\">North</div><div role=\"cell\">Open</div></div>\n        </div>\n        <stat-table></stat-table>\n        <script>\n            customElements.define('stat-table', class extends HTMLElement {\n                connectedCallback() {\n                    this.attachShadow({ mode: 'open' }).innerHTML =\n                        '<table id=\"shadow-stats\"><caption>Visitors</caption>' +\n                        '<tr><th scope=\"col\" id=\"shadow-day\">Day</th><th scope=\"col\">Visitors</th></tr>' +\n                        '<tr><td headers=\"shadow-day\">Monday</td><td>310</td></tr></table>';\n                }\n            });\n        </script>\n    </main>\n    <footer><p>City Library, 1 Market Square</p></footer>\n</body>\n</html>"
