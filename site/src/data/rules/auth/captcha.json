{
  "id": "auth/captcha",
  "url": "https://casoon.github.io/auditmysite/rules/auth/captcha/",
  "title": "Review CAPTCHA in authentication form",
  "outcome": "hint-only",
  "criterion": "3.3.8",
  "level": "AA",
  "axe_id": "accessible-auth-captcha",
  "dimension": "Accessibility",
  "subcategory": "Forms & Interaction",
  "issue_class": "Risk",
  "severity": "medium",
  "user_impact": "Text and puzzle CAPTCHAs lock people with cognitive impairments, dyslexia or low vision out of signing in when no alternative is offered.",
  "technical_impact": "Interactive CAPTCHA widget (reCAPTCHA, hCaptcha, image CAPTCHA) in a form with a password or one-time-code field.",
  "source": "WCAG 2.2 SC 3.3.8 Accessible Authentication (Minimum); Understanding 3.3.8 (object recognition, alternative)",
  "applicability": "Rendered forms with a password or one-time-code field (an authentication step).",
  "expectation": "Needs review when such a form contains a visible CAPTCHA (reCAPTCHA or\nhCaptcha widget, an image whose src, alt, id or class names a captcha): it\nis a cognitive function test unless it is object recognition or an\nalternative exists, which the markup does not show. Invisible CAPTCHAs set\nno test and are not reported; a CAPTCHA outside authentication (a contact\nform) is not 3.3.8.",
  "method": "shared",
  "capabilities": [
    "dom"
  ],
  "page_level": false,
  "failing": {
    "case": "accessible_authentication",
    "file": "tests/fixtures/detection_corpus/accessible_authentication.html",
    "verdict": "needs_review",
    "selector": "form#login-captcha",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Accessible authentication</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n  /* #783: page shell, so the case only reports what it is about */\n  .skip, nav a { display: inline-block; padding: 12px; min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  button, input, select, textarea { min-height: 44px; min-width: 44px; box-sizing: border-box; }\n  input[type=\"checkbox\"], input[type=\"radio\"] { width: 44px; height: 44px; }\n</style></head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to main content</a>\n<header><p>Example Shop</p><nav aria-label=\"Main\"><a href=\"/\" aria-current=\"page\">Home</a> <a href=\"/help\">Help</a></nav></header>\n<main id=\"main\">\n  <h1>Sign in</h1>\n\n  <!-- Violation: paste blocked via addEventListener + preventDefault. -->\n  <form id=\"login-blocked\" action=\"/login\" method=\"post\">\n    <label for=\"user-a\">Username</label>\n    <input id=\"user-a\" name=\"username\" type=\"text\" autocomplete=\"username\">\n    <label for=\"pw-blocked\">Password</label>\n    <input id=\"pw-blocked\" name=\"password\" type=\"password\" autocomplete=\"current-password\">\n    <button type=\"submit\">Sign in</button>\n  </form>\n\n  <!-- Violation: paste blocked via inline onpaste=\"return false\". -->\n  <form id=\"otp-form\" action=\"/verify\" method=\"post\">\n    <label for=\"otp-blocked\">Verification code</label>\n    <input id=\"otp-blocked\" name=\"otp\" type=\"text\" inputmode=\"numeric\" autocomplete=\"one-time-code\" onpaste=\"return false\">\n    <button type=\"submit\">Verify</button>\n  </form>\n\n  <!-- Pass: paste allowed. -->\n  <form id=\"login-ok\" action=\"/login\" method=\"post\">\n    <label for=\"user-b\">E-mail</label>\n    <input id=\"user-b\" name=\"email\" type=\"email\" autocomplete=\"username\">\n    <label for=\"pw-ok\">Password</label>\n    <input id=\"pw-ok\" name=\"password2\" type=\"password\" autocomplete=\"current-password\">\n    <button type=\"submit\">Sign in</button>\n  </form>\n\n  <!-- Pass: handler cancels the native paste but inserts the trimmed text itself. -->\n  <form id=\"login-sanitised\" action=\"/login\" method=\"post\">\n    <label for=\"pw-sanitised\">Password</label>\n    <input id=\"pw-sanitised\" name=\"password3\" type=\"password\" autocomplete=\"current-password\">\n    <button type=\"submit\">Sign in</button>\n  </form>\n\n  <!-- Needs review: image CAPTCHA inside an authentication form. -->\n  <form id=\"login-captcha\" action=\"/login\" method=\"post\">\n    <label for=\"pw-captcha\">Password</label>\n    <input id=\"pw-captcha\" name=\"password4\" type=\"password\" autocomplete=\"current-password\">\n    <img id=\"captcha-image\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" alt=\"captcha\" width=\"120\" height=\"40\">\n    <label for=\"captcha-answer\">Type the characters shown</label>\n    <input id=\"captcha-answer\" name=\"captcha\" type=\"text\">\n    <button type=\"submit\">Sign in</button>\n  </form>\n\n  <!-- Not authentication: CAPTCHA on a contact form is out of scope. -->\n  <form id=\"contact\" action=\"/contact\" method=\"post\">\n    <label for=\"msg\">Message</label>\n    <textarea id=\"msg\" name=\"message\"></textarea>\n    <img id=\"contact-captcha\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" alt=\"captcha\" width=\"120\" height=\"40\">\n    <button type=\"submit\">Send</button>\n  </form>\n</main>\n<footer><p>Example Shop, 2026</p></footer>\n<script>\n  document.getElementById('pw-blocked').addEventListener('paste', function (e) {\n    e.preventDefault();\n    alert('Pasting is not allowed');\n  });\n  document.getElementById('pw-sanitised').addEventListener('paste', function (e) {\n    e.preventDefault();\n    var text = (e.clipboardData && e.clipboardData.getData('text/plain')) || '';\n    this.value = text.trim();\n  });\n</script>\n</body>\n</html>"
  },
