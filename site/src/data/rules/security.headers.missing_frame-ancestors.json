{
  "id": "security.headers.missing_frame-ancestors",
  "url": "https://casoon.github.io/auditmysite/rules/security.headers.missing_frame-ancestors/",
  "domain": "security",
  "title": "Missing frame-ancestors",
  "outcome": "automatic",
  "area": "Security, response headers",
  "checks": [
    {
      "contract_id": "Content-Security-Policy:missing_frame-ancestors",
      "label": "Content-Security-Policy",
      "outcome": "automatic",
      "source": "CSP Level 3, 'Directives' (script-src, style-src and object-src fall back to default-src; base-uri and frame-ancestors have no fallback), 'Does a source list allow all inline behavior for type?' ('unsafe-inline' is ignored next to a nonce or hash), 'Policy lists' (every policy is enforced); Google CSP Evaluator",
      "applicability": "Applies to responses with at least one enforced Content-Security-Policy header; without one (or with only a report-only policy) there is no policy to judge.",
      "expectation": "Fails when no policy sets frame-ancestors; it has no fallback to default-src. Without an enforced CSP the check does not apply (that is the missing_header finding).",
      "method": "analyze_security",
      "capabilities": [
        "network"
      ],
      "page_level": true,
      "failing": {
        "case": "csp_permissive",
        "file": "tests/fixtures/detection_corpus_nonwcag/security/csp_permissive.expected.json",
        "verdict": "violation",
        "response_headers": {
          "Content-Security-Policy": "default-src *; script-src 'unsafe-inline' 'unsafe-eval' *; style-src 'unsafe-inline'",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "geolocation=(), camera=()",
          "Referrer-Policy": "strict-origin-when-cross-origin",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY"
        }
      },
      "passing": {
        "case": "security_https_complete",
        "file": "tests/fixtures/detection_corpus_nonwcag/security/security_https_complete.expected.json",
        "verdict": "pass",
        "response_headers": {
          "Content-Security-Policy": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Resource-Policy": "same-origin",
          "Permissions-Policy": "geolocation=(), camera=()",
          "Referrer-Policy": "strict-origin-when-cross-origin",
          "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "DENY"
        }
      }
    }
  ]
}
