src=\"/later.png\" hidden>\n        <img id=\"town-map\" src=\"/town.png\" usemap=\"#town-areas\" alt=\"Old town districts\" width=\"200\" height=\"120\">\n        <map name=\"town-areas\">\n            <area id=\"area-market\" href=\"/districts/market\" shape=\"rect\" coords=\"0,0,100,60\" alt=\"Market district\">\n            <area id=\"area-harbour\" href=\"/districts/harbour\" shape=\"rect\" coords=\"100,0,200,60\" aria-label=\"Harbour district\">\n            <area id=\"area-decor\" shape=\"rect\" coords=\"0,60,200,120\">\n        </map>\n        <form action=\"/search\">\n            <label for=\"q\">Search the collection</label>\n            <input id=\"q\" name=\"q\" type=\"search\">\n            <input id=\"search-go\" type=\"image\" src=\"/go.png\" alt=\"Search\">\n            <span id=\"reset-label\" hidden>Clear search</span>\n            <input id=\"search-clear\" type=\"image\" src=\"/clear.png\" aria-labelledby=\"reset-label\">\n        </form>\n        <object id=\"catalogue-pdf\" data=\"/catalogue.pdf\" type=\"application/pdf\" width=\"300\" height=\"200\">\n            <a href=\"/catalogue.pdf\">Download the exhibition catalogue (PDF)</a>\n        </object>\n        <object id=\"floor-plan\" data=\"/floor.svg\" type=\"image/svg+xml\" title=\"Floor plan of the exhibition\" width=\"300\" height=\"200\"></object>\n        <audio id=\"muted-loop\" autoplay muted loop src=\"/ambience.mp3\"></audio>\n        <audio id=\"tour-audio\" controls src=\"/tour.mp3\"></audio>\n        <span id=\"warning-icon\" role=\"img\" aria-label=\"Warning\" class=\"icon\"></span>\n        <span id=\"decor-icon\" role=\"img\" class=\"icon\" aria-hidden=\"true\"></span>\n        <a href=\"/print\"><span id=\"print-icon\" role=\"img\" class=\"icon\"></span>Print this page</a>\n    </main>\n    <footer><p>City Library, 1 Market Square</p></footer>\n</body>\n</html>"
