    "verdict": "violation",
    "html": "<!DOCTYPE html>\n<html lang=\"en\" xml:lang=\"de\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=3\">\n    <title>Misc content checks corpus case</title>\n    <style>\n        .low-contrast-checkbox {\n            border: 1px solid #f8f8f8;\n            background: #ffffff;\n        }\n        /* Controls sized to 44px: this case is not about target size. */\n        button, input { min-width: 44px; min-height: 44px; }\n        .inline-link {\n            color: blue;\n            text-decoration: none;\n        }\n    </style>\n</head>\n<body>\n    <main>\n        <h1>Image maps, tables, abbreviations, and misc issues</h1>\n\n        <!-- area-alt -->\n        <img src=\"/floorplan.png\" usemap=\"#floor-map\" alt=\"Floor plan\">\n        <map name=\"floor-map\">\n            <area href=\"/room1\" shape=\"rect\" coords=\"0,0,50,50\">\n        </map>\n\n        <!-- input-image-alt -->\n        <input type=\"image\" src=\"/submit.png\">\n\n        <!-- presentation-semantic-children: dropped in #697 — role=\"presentation\" does not\n             strip the semantics of descendants (WAI-ARIA 1.2), so this is no finding -->\n        <div role=\"presentation\">\n            <button>Semantic button inside a presentation container</button>\n        </div>\n\n        <!-- tables/header-missing: data table without any headers -->\n        <table>\n            <tbody>\n                <tr><td>Alice</td><td>90</td></tr>\n                <tr><td>Bob</td><td>85</td></tr>\n            </tbody>\n        </table>\n\n        <!-- redundant-entry: two email fields without reuse/autocomplete -->\n        <form>\n            <label for=\"email-a\">Email</label>\n            <input type=\"email\" id=\"email-a\" name=\"email_a\">\n            <label for=\"email-b\">Confirm email</label>\n            <input type=\"email\" id=\"email-b\" name=\"email_b\">\n        </form>\n\n        <!-- abbreviations -->\n        <p><abbr>W3C</abbr> publishes web standards.</p>\n\n        <!-- modern-attribute-misuse: popovertarget references a missing element -->\n        <button popovertarget=\"missing-popover-id\">Open</button>\n\n        <!-- non-text-contrast-css: checkbox border barely distinguishable from background -->\n        <input type=\"checkbox\" class=\"low-contrast-checkbox\">\n\n        <!-- link-in-text-block: inline link distinguished only by color -->\n        <p>Read our <a href=\"/policy\" class=\"inline-link\">privacy policy</a> for details.</p>\n    </main>\n</body>\n</html>"
  },
  "passing": {
