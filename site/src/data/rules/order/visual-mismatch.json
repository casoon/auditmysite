    "case": "interaction_reading_order",
    "file": "tests/fixtures/detection_corpus/interaction_reading_order.html",
    "verdict": "needs_review",
    "selector": "div#ord-reverse",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Visual order and DOM order</title>\n    <style>\n        body { font-family: sans-serif; margin: 0; padding: 16px; color: #111; background: #fff; }\n        a, button { display: inline-block; min-width: 44px; min-height: 44px; padding: 12px; box-sizing: border-box; margin: 4px; }\n        .skip { position: absolute; left: -9999px; }\n        .skip:focus { left: 16px; }\n        .flex { display: flex; gap: 16px; margin: 16px 0; }\n        .reverse { flex-direction: row-reverse; }\n        .column-reverse { flex-direction: column-reverse; }\n        .first { order: -1; }\n        .zero { order: 0; }\n        .hidden-reverse { display: none; flex-direction: row-reverse; }\n        @media (max-width: 600px) { .mobile-reverse { flex-direction: column-reverse; } }\n    </style>\n</head>\n<body>\n    <a class=\"skip\" href=\"#main\">Skip to main content</a>\n    <header><p>Example News</p></header>\n    <nav aria-label=\"Main\">\n        <a href=\"/\" aria-current=\"page\">Home</a>\n        <a href=\"/world\">World</a>\n    </nav>\n    <main id=\"main\">\n        <h1>Today's stories</h1>\n\n        <!-- needs_review: row-reverse over two links to different stories -->\n        <div id=\"ord-reverse\" class=\"flex reverse\">\n            <a href=\"/story/1\">First story</a>\n            <a href=\"/story/2\">Second story</a>\n        </div>\n        <!-- needs_review: column-reverse over two paragraphs, reading order differs from DOM order -->\n        <div id=\"ord-column\" class=\"flex column-reverse\">\n            <p>Step one: register.</p>\n            <p>Step two: confirm your e-mail.</p>\n        </div>\n        <!-- needs_review: order moves the second item to the front -->\n        <div id=\"ord-order\" class=\"flex\">\n            <p>Price: 20 euros.</p>\n            <p class=\"first\">Offer ends Friday.</p>\n        </div>\n        <!-- absent: order 0 is the default and moves nothing -->\n        <div id=\"ord-zero\" class=\"flex\">\n            <p class=\"zero\">Weather: sunny.</p>\n            <p>Wind: light.</p>\n        </div>\n        <!-- absent: a teaser card whose image and title link go to the same story -->\n        <div id=\"ord-same-target\" class=\"flex reverse\">\n            <a href=\"/story/3\">Picture of the harbour</a>\n            <a href=\"/story/3\">Harbour reopens</a>\n        </div>\n        <!-- absent: only one child, nothing to reorder -->\n        <div id=\"ord-single\" class=\"flex reverse\">\n            <p>Editor's note.</p>\n        </div>\n        <!-- absent: not rendered -->\n        <div id=\"ord-hidden\" class=\"hidden-reverse\">\n            <p>Archived item one.</p>\n            <p>Archived item two.</p>\n        </div>\n        <!-- needs_review on the mobile viewport only -->\n        <div id=\"ord-mobile\" class=\"flex mobile-reverse\">\n            <a href=\"/story/4\">Read the interview</a>\n            <a href=\"/story/5\">Watch the video</a>\n        </div>\n        <!-- needs_review: a script reverses it after load -->\n        <div id=\"ord-dynamic\" class=\"flex\">\n            <a href=\"/story/6\">Harbour festival recap</a>\n            <a href=\"/story/7\">Lighthouse tour dates</a>\n        </div>\n    </main>\n    <footer><p>Example News footer</p></footer>\n    <script>\n        document.getElementById('ord-dynamic').classList.add('reverse');\n    </script>\n</body>\n</html>"
  },
