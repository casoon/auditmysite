    "verdict": "needs_review",
    "selector": "button#close-player",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Media player - Example radio</title>\n</head>\n<body>\n    <header>\n        <p>Example radio</p>\n    </header>\n    <main>\n        <h1>Live stream</h1>\n\n        <!-- names/required-missing: custom controls whose name sources come\n             out empty -->\n        <div id=\"volume\" role=\"slider\" tabindex=\"0\" aria-valuenow=\"7\" aria-valuemin=\"0\" aria-valuemax=\"10\"></div>\n        <div id=\"autoplay\" role=\"switch\" tabindex=\"0\" aria-checked=\"false\" aria-labelledby=\"autoplay-label\"></div>\n        <span id=\"autoplay-label\"></span>\n        <label for=\"station\">   </label>\n        <input id=\"station\" type=\"text\">\n\n        <!-- names/symbol-only: the author-provided name is a single symbol -->\n        <button type=\"button\" id=\"close-player\" aria-label=\"&#x00D7;\"><span aria-hidden=\"true\">&#x00D7;</span></button>\n\n        <!-- names/title-only: the title tooltip is the only name -->\n        <button type=\"button\" id=\"share\" title=\"Share\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\"><circle cx=\"8\" cy=\"8\" r=\"6\"></circle></svg></button>\n\n        <!-- label-in-name/mismatch: spoken \"Play\" does not match the name -->\n        <button type=\"button\" id=\"play\" aria-label=\"Start stream\">Play</button>\n        <!-- the visible label stays visible under aria-hidden -->\n        <button type=\"button\" id=\"skip\" aria-label=\"Next song\"><span aria-hidden=\"true\">Skip</span></button>\n        <!-- named by aria-labelledby, which leaves out the visible \"Back\" -->\n        <button type=\"button\" id=\"rewind\" aria-labelledby=\"rewind-label\">Back</button>\n        <span id=\"rewind-label\" hidden>Rewind 10 seconds</span>\n        <!-- threshold: visible text exactly twice as long as the name still\n             is the label, so it fails -->\n        <button type=\"button\" id=\"continue\" aria-label=\"Next\">Continue</button>\n        <!-- threshold: visible text more than twice the name, a card whose\n             visible label is ambiguous: review -->\n        <a href=\"/shows/jazz-night\" id=\"show-card\" aria-label=\"Jazz night\">Tonight on air: smooth jazz from the archives</a>\n\n        <!-- description-duplicates-name: name and description identical -->\n        <button type=\"button\" id=\"mute\" aria-describedby=\"mute-desc\">Mute</button>\n        <span id=\"mute-desc\" hidden>Mute</span>\n\n        <!-- summary/name-missing: empty disclosure summary -->\n        <details id=\"lyrics\">\n            <summary id=\"lyrics-summary\"></summary>\n            <p>No lyrics available.</p>\n        </details>\n\n        <!-- svg/name-missing: an explicit image without a name -->\n        <svg id=\"cover\" role=\"img\" width=\"120\" height=\"120\" viewBox=\"0 0 120 120\">\n            <rect width=\"120\" height=\"120\" fill=\"#335\"></rect>\n        </svg>\n        <!-- svg/name-missing (review): no role, may be decoration -->\n        <svg id=\"waveform\" width=\"200\" height=\"40\" viewBox=\"0 0 200 40\">\n            <path d=\"M0 20 L200 20\" stroke=\"#000\"></path>\n        </svg>\n    </main>\n    <footer>\n        <p>Example radio</p>\n    </footer>\n</body>\n</html>"
  },
