        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Expandable treegrid rows and tree items corpus case</title>\n</head>\n<body>\n    <main>\n        <h1>Grouped orders</h1>\n        <!-- WAI-ARIA treegrid pattern: aria-expanded on a parent row is the\n             pattern's own state, not an accordion trigger (#655). -->\n        <table role=\"treegrid\" aria-label=\"Orders\">\n            <thead>\n                <tr><th>Country</th><th>Amount</th></tr>\n            </thead>\n            <tbody>\n                <tr aria-level=\"1\" aria-expanded=\"true\" tabindex=\"0\">\n                    <td>Country: AT (2 rows)</td><td>300</td>\n                </tr>\n                <tr aria-level=\"2\"><td>Vienna</td><td>100</td></tr>\n                <tr aria-level=\"2\"><td>Graz</td><td>200</td></tr>\n                <tr aria-level=\"1\" aria-expanded=\"false\" tabindex=\"-1\">\n                    <td>Country: CH (1 row)</td><td>50</td>\n                </tr>\n            </tbody>\n        </table>\n\n        <div role=\"grid\" aria-label=\"Plain grid\">\n            <div role=\"row\" aria-expanded=\"false\" tabindex=\"-1\">\n                <div role=\"gridcell\">Group row</div>\n            </div>\n        </div>\n\n        <ul role=\"tree\" aria-label=\"Files\">\n            <li role=\"treeitem\" aria-expanded=\"false\" tabindex=\"0\">src</li>\n            <li role=\"treeitem\" tabindex=\"-1\">README.md</li>\n        </ul>\n    </main>\n</body>\n</html>"
