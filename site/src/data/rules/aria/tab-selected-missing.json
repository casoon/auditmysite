        "verdict": "needs_review",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>ARIA and widget corpus case</title>\n</head>\n<body>\n    <main>\n        <h1>ARIA relationships, widget state, and tab semantics</h1>\n\n        <button aria-label=\"\"><svg aria-hidden=\"true\" width=\"10\" height=\"10\"></svg></button>\n\n        <div role=\"alert\" aria-live=\"polite\">A critical error occurred</div>\n\n        <div role=\"slider\" aria-label=\"Volume\" tabindex=\"0\"></div>\n\n        <div role=\"tablist\">\n            <div role=\"tab\" id=\"tab1\" aria-controls=\"panel1\">First tab (missing aria-selected)</div>\n            <div role=\"tab\" id=\"tab2\" aria-selected=\"false\" aria-controls=\"panel1\">Second tab</div>\n        </div>\n        <div role=\"tabpanel\" id=\"panel1\">Panel content</div>\n    </main>\n</body>\n</html>"
