  "user_impact": "Assistive technologies cannot reliably expose the element state or value.",
  "technical_impact": "Role and ARIA attribute set are incomplete.",
  "source": "WCAG 2.2 SC 4.1.2 Name, Role, Value; WAI-ARIA 1.2 section 5.2.5 (Required States and Properties); ACT 4e8ab6",
  "applicability": "Elements in the accessibility tree with an explicit role that requires states: checkbox, switch, radio (aria-checked), combobox (aria-expanded), slider, spinbutton, meter (aria-valuenow), scrollbar (aria-controls, aria-valuenow), focusable separator (aria-valuenow).",
  "expectation": "Fails when a required state is missing: a custom checkbox or switch without aria-checked\nis announced without its state, a combobox without aria-expanded, a slider without aria-valuenow. A\nnative element that carries the state itself passes (<input type=checkbox role=switch>, <input\ntype=range role=slider>, <meter>), as does a static separator without tabindex. Hidden subtrees are\nout of scope; open shadow roots are in scope.",
  "method": "shared",
  "capabilities": [
    "dom",
    "ax_tree"
  ],
  "page_level": false,
  "failing": {
    "case": "value_widgets_shadow",
    "file": "tests/fixtures/detection_corpus/value_widgets_shadow.html",
    "verdict": "violation",
    "selector": "div#shadow-volume",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Custom slider inside a shadow root corpus case</title>\n</head>\n<body>\n    <main>\n        <h1>Web component with a custom slider</h1>\n        <x-volume>\n            <template shadowrootmode=\"open\">\n                <div id=\"shadow-volume\" role=\"slider\" tabindex=\"0\" aria-label=\"Volume\"></div>\n            </template>\n        </x-volume>\n    </main>\n</body>\n</html>"
  },
  "passing": {
    "case": "value_widgets_native",
    "file": "tests/fixtures/detection_corpus/value_widgets_native.html",
    "verdict": "pass",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Native value widgets corpus case</title>\n</head>\n<body>\n    <main>\n        <h1>Native range, number and date inputs</h1>\n        <!-- Native controls expose their value without aria-valuenow, and the\n             day/month/year fields of a date input are the browser's (#656). -->\n        <label for=\"volume\">Volume</label>\n        <input id=\"volume\" type=\"range\" min=\"0\" max=\"10\">\n        <label for=\"zoom\">Zoom</label>\n        <input id=\"zoom\" type=\"range\" role=\"slider\" value=\"3\" min=\"0\" max=\"10\">\n        <label for=\"qty\">Quantity</label>\n        <input id=\"qty\" type=\"number\">\n        <label for=\"amount\">Amount</label>\n        <input id=\"amount\" type=\"number\" value=\"4\">\n        <input type=\"date\" aria-label=\"Order date value\">\n        <label for=\"time\">Pickup time</label>\n        <input id=\"time\" type=\"time\">\n        <label for=\"month\">Billing month</label>\n        <input id=\"month\" type=\"month\">\n        <label for=\"week\">Calendar week</label>\n        <input id=\"week\" type=\"week\">\n        <label for=\"appointment\">Appointment</label>\n        <input id=\"appointment\" type=\"datetime-local\">\n        <label for=\"disk\">Disk usage</label>\n        <meter id=\"disk\" value=\"0.6\">60%</meter>\n        <hr>\n        <div role=\"slider\" tabindex=\"0\" aria-label=\"Custom with value\"\n             aria-valuenow=\"5\" aria-valuemin=\"0\" aria-valuemax=\"10\"></div>\n        <div role=\"slider\" aria-label=\"Hidden custom slider\" style=\"display:none\"></div>\n    </main>\n</body>\n</html>"
  }
}
