---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  BuildOutput,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { castDemo, fixture } from '../showcase';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const quickstart = `# check which browser auditmysite will use
auditmysite browser detect

# full single-page audit: terminal summary, PDF and JSON in the current directory
auditmysite https://example.com

# machine-readable, for CI
auditmysite https://example.com -f json -o report.json --quiet

# domain-wide, aggregated
auditmysite --sitemap https://example.com/sitemap.xml --max-pages 20`;
---

<Base>
  <Hero
    title="Accessibility audits of the rendered page."
    lead="auditmysite loads each page in Chrome, reads Chrome's own accessibility tree over the DevTools Protocol and checks it against WCAG 2.2 AA. One binary, JSON for automation, PDF reports in German and English."
  >
    <Install
      label="Install method"
      commands={[
        { label: 'installer', command: 'curl -fsSL https://raw.githubusercontent.com/casoon/auditmysite/main/install.sh | bash' },
        { label: 'cargo', command: 'cargo install auditmysite' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>JSON + PDF</Badge>
      <Badge>WCAG 2.2 AA</Badge>
      <Badge>macOS · Linux · Windows</Badge>
    </Badges>
    {/* Excerpt of the recorded single-page audit (examples/hero-excerpt.sh): 64 columns, and
        a 50-column scene for phones. The full recording is in the showcase. */}
    <Fragment
      slot="output"
      set:html={castDemo('hero', 'cw-hero', 'auditmysite 1.7.0 on casoon.de', 'hero-narrow')}
    />
  </Hero>

  <Facts
    items={[
      { value: '55', label: 'WCAG 2.2 A/AA success criteria in scope' },
      { value: '30', label: 'of them covered by automated checks' },
      { value: '25', label: 'listed for manual review, never silently passed' },
      { value: '4', label: 'prebuilt release targets (macOS arm64, Linux x64/arm64, Windows x64)' },
    ]}
  />

  <Features
    items={[
      {
        title: "Chrome's accessibility tree, not a static guess",
        body: 'Pages are rendered in Chrome and audited through the DevTools Protocol, so JavaScript-rendered content, computed styles and the browser’s own accessible names are what gets checked.',
      },
      {
        title: 'Honest WCAG coverage',
        body: 'A criterion counts as automated only if a rule can report a violation. The numbers are frozen in docs/PARITY_CONTRACT.jsonc and guarded by a test; every report carries them in summary.wcag_coverage.',
      },
      {
        title: 'JSON contract, PDF for people',
        body: 'The JSON report is canonical English and schema-backed for automation. The PDF is tagged PDF/UA-1 and rendered in German or English (--lang de|en).',
      },
      {
        title: 'Single pages and whole sites',
        body: 'Audit one URL in depth, or a sitemap, a URL list or a same-domain crawl as one aggregated batch report with averages, ranking and recurring issues. Technician mode writes one JSON per page plus a flat findings.jsonl instead.',
      },
      {
        title: 'Shared rules with barrierlab',
        body: 'Common WCAG rules, accessible name computation and HTML conformance come from the barrierlab crates, so the same rule IDs apply in auditmysite, astro-post-audit and liveaudit.',
      },
    ]}
  />

  <section class="ways" aria-labelledby="ways-title">
    <h2 class="cp-label" id="ways-title">Three ways to a report</h2>
    <ul>
      <li>
        <h3><a href="https://github.com/casoon/auditmysite">The CLI</a></h3>
        <p>
          The Rust binary on this page: a single URL, a sitemap, a URL list or a same-domain crawl,
          on macOS, Linux and Windows.
        </p>
      </li>
      <li>
        <h3><a href="https://github.com/casoon/auditmysite_downloads/releases">AuditMySite Studio</a></h3>
        <p>
          A desktop app (Tauri) on the same audit logic: audits grouped per domain, compared over
          time, reports written locally as PDF. Alpha, latest release 0.2.13 (21 May 2026). The
          source is not public; the installers are in the downloads repository.
        </p>
      </li>
      <li>
        <h3><a href="https://casoon.github.io/renderreport/">The report engine</a></h3>
        <p>
          The PDF reports are rendered with renderreport and Typst, as tagged PDF/UA-1. If
          rendering fails, there is a diagnostic instead of a silent fallback.
        </p>
      </li>
    </ul>
  </section>

  <BuildOutput
    caption="Real output of auditmysite, recorded against casoon.de with examples/record.sh and rendered when this site is built. The showcase has technician mode, the JSON coverage block and report-lint as well."
    file="examples/plan.txt"
    heading="What an audit will do"
  >
    <Terminal ansi={fixture('plan.txt')} />
  </BuildOutput>

  <Quickstart
    lead="Install the binary, make sure a Chrome is available, point it at a URL. The documentation covers batch modes, reports and CI."
    steps={[
      'Install with the installer script, <code>cargo install auditmysite</code> or a release binary.',
      'Run <code>auditmysite browser detect</code>. Without a system Chrome, <code>auditmysite browser install</code> fetches Chrome for Testing.',
      'Run <code>auditmysite &lt;url&gt;</code> for a report, or <code>-f json</code> for automation.',
    ]}
  >
    <CodeBlock code={quickstart} lang="sh" title="shell" label="Shell" />
  </Quickstart>
  <section class="demo" aria-labelledby="demo-title">
    <h2 class="cp-label" id="demo-title">Results from real audits</h2>
    <figure>
      <img
        src={url('screens/rankinglab-start-700.webp')}
        srcset={`${url('screens/rankinglab-start-700.webp')} 700w, ${url('screens/rankinglab-start.webp')} 1400w`}
        sizes="(min-width: 760px) 720px, 100vw"
        width="1400"
        height="875"
        loading="lazy"
        alt="RankingLab: start page with public accessibility rankings"
      />
      <figcaption>
        <a href="https://rankinglab.casoon.dev/">rankinglab.casoon.dev</a>: public rankings
        produced with auditmysite, of publicly reachable pages. Captured on 2026-09-16.
      </figcaption>
    </figure>
  </section>

  <section class="limits" aria-labelledby="limits-title">
    <h2 class="cp-label" id="limits-title">What an automated audit does not do</h2>
    <p class="lead">
      Automated checking covers part of accessibility. The rest needs human judgement, and the
      report says so.
    </p>
    <dl>
      <dt>Not every criterion can be automated</dt>
      <dd>
        Keyboard traps, timed content and captions cannot be verified reliably by machine. They are
        flagged <code>not_testable</code> in the JSON and listed in the report's audit scope, never
        silently passed.
      </dd>
      <dt>No accessibility statement</dt>
      <dd>
        The EN 301 549 appendix is a technical building block for a statement written by people. It
        is not a statement, not legal advice and not a confirmation of conformity under BFSG or
        BITV 2.0.
      </dd>
      <dt>Heuristic modules are tendencies</dt>
      <dd>
        Indicator scores such as UX or readability heuristics are estimates, not measurements, and
        no statement of conformity.
      </dd>
      <dt>AAA is not fully implemented</dt>
      <dd><code>-l AAA</code> exists, but coverage of level AAA is still incomplete.</dd>
      <dt>A browser has to be present</dt>
      <dd>
        Without Chrome or Chromium the run stops with an error. A browser is only downloaded on
        request, with <code>auditmysite browser install</code>.
      </dd>
      <dt>Linked PDF documents are not checked</dt>
      <dd>
        Rendered web pages are audited. Linked or embedded PDF files are a documented non-goal.
      </dd>
    </dl>
  </section>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Does auditmysite download or install a browser automatically?',
        a: 'No. It requires Chrome, Chromium, or a managed browser to already be present and exits with an error if none is found. auditmysite browser install fetches Chrome for Testing, but only when you run it yourself.',
      },
      {
        q: 'Is the PDF report an accessibility statement I can publish?',
        a: 'No. The EN 301 549 appendix and the JSON findings are a technical building block for a statement a person writes; the report explicitly does not claim conformance under BFSG or BITV 2.0.',
      },
      {
        q: 'Does 100% automated pass mean the page is fully WCAG 2.2 AA compliant?',
        a: "No. Of the 55 WCAG 2.2 A/AA success criteria, only 30 are counted as automated, and a criterion counts there only if a rule can actually report a violation. The other 25 are listed as requiring manual review, never silently marked as passed.",
      },
      {
        q: 'Where do the WCAG rule ids and checks come from?',
        a: 'From the barrierlab crates (a11y-rules, a11y-dom, accname, html-conform, and related crates), a shared Rust monorepo also used by astro-post-audit and LiveAudit, so the same rule id means the same thing across all three tools. Rule ids stay stable across auditmysite releases, with renames documented when a collision is fixed.',
      },
      {
        q: 'Can it audit more than one page at a time?',
        a: 'Yes. Point it at a sitemap, a URL file, or a seed URL with --crawl, and it writes one aggregated batch report with averages, ranking, and recurring issues across pages. --technician switches that same batch run to one JSON file per page plus a flat findings.jsonl instead.',
      },
    ]}
  />
</Base>

<style>
  .ways,
  .demo,
  .limits {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 64px;
  }
  .ways ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .ways h3 {
    margin: 0 0 6px;
  }
  .ways p,
  .limits dd {
    color: var(--muted);
    margin: 0;
  }
  .demo figure {
    margin: 0;
    max-width: 720px;
  }
  .demo img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }
  .demo figcaption {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 8px;
  }
  .limits .lead {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .limits dl {
    display: grid;
    gap: 6px 24px;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
  }
  .limits dt {
    font-weight: 600;
    color: var(--heading);
    margin-top: 14px;
  }
</style>
