---
import { readFile } from 'node:fs/promises';
import {
  AudienceList,
  Badge,
  Badges,
  CodeBlock,
  ElementList,
  Faq,
  Hero,
  Install,
  Keymap,
  Quickstart,
  ReleaseHighlights,
  SectionIntro,
  Showcase,
  Split,
  StatBand,
  Tradeoffs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { castDemo } from '../showcase';

// The frozen WCAG numbers come from the parity contract, not from this page.
const contract = JSON.parse(
  (await readFile('../docs/PARITY_CONTRACT.jsonc', 'utf8')).replace(
    /^\s*\/\/.*$/gm,
    ''
  )
).frozen_numbers;
const total = contract.wcag_aa_total_criteria;
const automated = contract.automated_wcag_aa_criteria;
const manual = contract.manual_review_criteria;

const coverage = `{
  "wcag_version": "2.2",
  "level": "WCAG 2.2 AA",
  "total_wcag_aa_criteria": ${total},
  "automated_criteria": ${automated},
  "manual_review_criteria": ${manual}
}`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const quickstart = `# check which browser auditmysite will use
auditmysite browser detect

# full single-page audit: a table in the terminal, nothing written
auditmysite https://example.com

# machine-readable, for CI
auditmysite https://example.com -f json -o report.json --quiet

# domain-wide, aggregated
auditmysite --sitemap https://example.com/sitemap.xml --max-pages 20`;
---

<Base>
  <Hero
    title="Accessibility audits of the rendered page."
    lead="auditmysite loads each page in Chrome, reads Chrome's own accessibility tree over the DevTools Protocol and checks it against WCAG 2.2 AA. One binary, JSON for automation, PDF reports in German and English."
  >
    <Install
      label="Install method"
      commands={[
        { label: 'installer', command: 'curl -fsSL https://raw.githubusercontent.com/casoon/auditmysite/main/install.sh | bash' },
        { label: 'cargo', command: 'cargo install auditmysite' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>JSON + PDF</Badge>
      <Badge>WCAG 2.2 AA</Badge>
      <Badge>macOS · Linux · Windows</Badge>
    </Badges>
    {/* Excerpt of the recorded single-page audit (assets/casts/hero-excerpt.sh): 64 columns, and
        a 50-column scene for phones. The full recording is in the showcase. */}
    <Fragment
      slot="output"
      set:html={castDemo('hero', 'cw-hero', 'auditmysite 1.7.0 on casoon.de', 'hero-narrow')}
    />
  </Hero>

  <StatBand
    items={[
      { value: String(total), label: 'WCAG 2.2 A/AA success criteria in scope' },
      { value: String(automated), label: 'of them covered by automated checks' },
      { value: String(manual), label: 'listed for manual review, never silently passed' },
      { value: '4', label: 'prebuilt release targets (macOS arm64, Linux x64/arm64, Windows x64)' },
    ]}
  />

  <SectionIntro
    title="The rendered page, not the source."
    lead="auditmysite audits what Chrome actually builds: JavaScript-rendered content, computed styles and the browser’s own accessible names."
  />

  <Split
    index="01"
    title="Chrome's accessibility tree, not a static guess"
    lead="Pages are rendered in Chrome and audited through the DevTools Protocol, so JavaScript-rendered content, computed styles and the browser’s own accessible names are what gets checked."
    note="Common WCAG rules, accessible name computation and HTML conformance come from the [barrierlab](https://github.com/casoon/barrierlab) crates, so the same rule IDs apply in auditmysite, astro-post-audit and liveaudit."
  >
    <Fragment set:html={castDemo('single-table', 'cw-single', 'auditmysite on casoon.de')} />
  </Split>

  <Split
    index="02"
    reverse
    numbered
    title="Honest WCAG coverage"
    lead="A criterion counts as automated only if a rule can report a violation. The numbers are frozen in `docs/PARITY_CONTRACT.jsonc` and guarded by a test."
    points={[
      'Total criteria in scope.',
      'Covered by an automated rule.',
      'Listed for manual review, never silently passed.',
    ]}
  >
    <CodeBlock
      code={coverage}
      lang="json"
      title="summary.wcag_coverage"
      label="JSON"
      marks={[
        { line: 4, n: 1 },
        { line: 5, n: 2 },
        { line: 6, n: 3 },
      ]}
    />
  </Split>

  <Split
    index="03"
    title="JSON contract, PDF for people"
    lead="The JSON report is canonical English and schema-backed for automation. The PDF is tagged PDF/UA-1 and rendered in English or German (`--lang en|de`)."
  >
    <ElementList
      items={[
        { term: '-f json', body: 'Canonical English, schema-backed, for automation and CI.' },
        { term: '-f pdf', body: 'Tagged PDF/UA-1 for people, in English or German.' },
        { term: '-f table', body: 'The compact terminal summary; the default, nothing is written.' },
      ]}
    />
  </Split>

  <Split
    index="04"
    reverse
    title="Single pages and whole sites"
    lead="Audit one URL in depth, or a sitemap, a URL list or a same-domain crawl as one aggregated batch report with averages, ranking and recurring issues."
  >
    <ElementList
      items={[
        { term: '<url>', body: 'One page, in depth.' },
        { term: '--sitemap', body: 'A sitemap as one aggregated batch report.' },
        { term: '--url-file', body: 'A list of URLs from a file.' },
        { term: '--crawl', body: 'A same-domain crawl from a seed URL.' },
        { term: '--per-page-reports', body: 'Technician mode: one JSON per page plus a flat `findings.jsonl`.' },
      ]}
    />
  </Split>

  <Showcase
    title="Results from real audits"
    lead="Public rankings produced with auditmysite, of publicly reachable pages. Captured on 2026-09-16."
    link={{ label: 'rankinglab.casoon.dev', href: 'https://rankinglab.casoon.dev/' }}
  >
    <img
      src={url('screens/rankinglab-start-700.webp')}
      srcset={`${url('screens/rankinglab-start-700.webp')} 700w, ${url('screens/rankinglab-start.webp')} 1400w`}
      sizes="(min-width: 760px) 720px, 100vw"
      width="1400"
      height="875"
      loading="lazy"
      alt="RankingLab: start page with public accessibility rankings"
    />
  </Showcase>

  <AudienceList
    heading="Three ways to a report"
    items={[
      {
        title: 'The CLI',
        body: 'The Rust binary on this page: a single URL, a sitemap, a URL list or a same-domain crawl, on macOS, Linux and Windows.',
      },
      {
        title: 'AuditMySite Studio',
        body: 'A desktop app (Tauri) on the same audit logic: audits grouped per domain, compared over time, reports written locally as PDF. Alpha, latest release 0.2.13 (21 May 2026). The source is not public; the installers are in the auditmysite_downloads repository.',
      },
      {
        title: 'The report engine',
        body: 'The PDF reports are rendered with renderreport and Typst, as tagged PDF/UA-1. If rendering fails, there is a diagnostic instead of a silent fallback.',
      },
    ]}
  />

  <Keymap
    heading="Common flags"
    groups={[
      {
        heading: 'What to audit',
        items: [
          { label: 'Sitemap, as one batch report', keys: ['-s', '<sitemap-url>'] },
          { label: 'URL list from a file', keys: ['-u', '<file>'] },
          { label: 'Same-domain crawl from the URL', keys: ['--crawl'] },
          { label: 'Cap the number of pages', keys: ['-m', '<num>'] },
        ],
      },
      {
        heading: 'What to check',
        items: [
          { label: 'Add performance, SEO, security, mobile', keys: ['--full'] },
          { label: 'WCAG level (AAA is incomplete)', keys: ['-l', 'A|AA|AAA'] },
        ],
      },
      {
        heading: 'What to write',
        items: [
          { label: 'Report format', keys: ['-f', 'json|pdf|table'] },
          { label: 'Output file', keys: ['-o', '<file>'] },
          { label: 'Report language (default en)', keys: ['--lang', 'en|de'] },
          { label: 'One JSON per page plus findings.jsonl', keys: ['--per-page-reports', '-f', 'json'] },
        ],
      },
    ]}
  />

  <Quickstart
    lead="Install the binary, make sure a Chrome is available, point it at a URL. The documentation covers batch modes, reports and CI."
    steps={[
      'Install with the installer script, <code>cargo install auditmysite</code> or a release binary.',
      'Run <code>auditmysite browser detect</code>. Without a system Chrome, <code>auditmysite browser install</code> fetches Chrome for Testing.',
      'Run <code>auditmysite &lt;url&gt;</code> for a report, or <code>-f json</code> for automation.',
    ]}
  >
    <CodeBlock code={quickstart} lang="sh" title="shell" label="Shell" />
  </Quickstart>
  <section class="demo" aria-labelledby="demo-title">
    <h2 class="cp-label" id="demo-title">Results from real audits</h2>
    <figure>
      <img
        src={url('screens/rankinglab-start-700.webp')}
        srcset={`${url('screens/rankinglab-start-700.webp')} 700w, ${url('screens/rankinglab-start.webp')} 1400w`}
        sizes="(min-width: 760px) 720px, 100vw"
        width="1400"
        height="875"
        loading="lazy"
        alt="RankingLab: start page with public accessibility rankings"
      />
      <figcaption>
        <a href="https://rankinglab.casoon.dev/">rankinglab.casoon.dev</a>: public rankings
        produced with auditmysite, of publicly reachable pages. Captured on 2026-09-16.
      </figcaption>
    </figure>
  </section>

  <Tradeoffs
    title="What an automated audit does not do"
    lead="Automated checking covers part of accessibility. The rest needs human judgement, and the report says so."
    items={[
      '**Not every criterion can be automated.** Keyboard traps, timed content and captions cannot be verified reliably by machine. They are flagged `not_testable` in the JSON and listed in the report’s audit scope, never silently passed.',
      '**No accessibility statement.** The EN 301 549 appendix is a technical building block for a statement written by people. It is not a statement, not legal advice and not a confirmation of conformity under BFSG or BITV 2.0.',
      '**Heuristic modules are tendencies.** Experimental indicators such as UX or AI visibility are off by default; they are estimates, not measurements, and no statement of conformity.',
      '**AAA is not fully implemented.** `-l AAA` exists, but coverage of level AAA is still incomplete.',
      '**A browser has to be present.** Without Chrome or Chromium the run stops with an error. A browser is only downloaded on request, with `auditmysite browser install`.',
      '**Linked PDF documents are not checked.** Rendered web pages are audited. Linked or embedded PDF files are a documented non-goal.',
    ]}
  />

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Does auditmysite download or install a browser automatically?',
        a: 'No. It requires Chrome, Chromium, or a managed browser to already be present and exits with an error if none is found. auditmysite browser install fetches Chrome for Testing, but only when you run it yourself.',
      },
      {
        q: 'Is the PDF report an accessibility statement I can publish?',
        a: 'No. The EN 301 549 appendix and the JSON findings are a technical building block for a statement a person writes; the report explicitly does not claim conformance under BFSG or BITV 2.0.',
      },
      {
        q: 'Does 100% automated pass mean the page is fully WCAG 2.2 AA compliant?',
        a: "No. Of the 55 WCAG 2.2 A/AA success criteria, only 30 are counted as automated, and a criterion counts there only if a rule can actually report a violation. The other 25 are listed as requiring manual review, never silently marked as passed.",
      },
      {
        q: 'Where do the WCAG rule ids and checks come from?',
        a: 'From the barrierlab crates (a11y-rules, a11y-dom, accname, html-conform, and related crates), a shared Rust monorepo also used by astro-post-audit and LiveAudit, so the same rule id means the same thing across all three tools. Rule ids stay stable across auditmysite releases, with renames documented when a collision is fixed.',
      },
      {
        q: 'Can it audit more than one page at a time?',
        a: 'Yes. Point it at a sitemap, a URL file, or a seed URL with --crawl, and it writes one aggregated batch report with averages, ranking, and recurring issues across pages. --per-page-reports -f json switches that same batch run to one JSON file per page plus a flat findings.jsonl instead.',
      },
    ]}
  />
</Base>

<style>
  /* A link inside the caption's text needs more than colour to stand out (axe link-in-text-block). */
  .demo figcaption a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
