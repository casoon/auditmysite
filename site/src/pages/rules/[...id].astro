---
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import RuleCheck from '../../components/RuleCheck.astro';
import { outcomes, type RulePage, rulePages } from '../../lib/rules';

export function getStaticPaths() {
  return rulePages.map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: RulePage };
const outcome = outcomes[page.outcome];
const criterion = page.criterion
  ? `${page.criterion}${page.level ? ` (level ${page.level})` : ''}`
  : undefined;
const nested = page.checks.length > 1;
---

<Base
  title={`${page.title} (${page.id})`}
  description={`${page.title}: what the check ${page.id} looks at and how it is tested.`}
>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url('rules/')}>All rules</a>
    </nav>
    <h1>{page.title}</h1>
    <p class="id"><code>{page.id}</code></p>

    <dl class="facts">
      {criterion && (<><dt>WCAG success criterion</dt><dd>{criterion}</dd></>)}
      <dt>Outcome class</dt>
      <dd><strong>{outcome.label}.</strong> {outcome.meaning}</dd>
      <dt>Area</dt>
      <dd>{page.area}</dd>
      {page.severity && (<><dt>Default severity</dt><dd>{page.severity}</dd></>)}
      {page.axe_id && (<><dt>axe-core rule</dt><dd><code>{page.axe_id}</code></dd></>)}
    </dl>

    {page.user_impact && (
      <>
        <h2>Why we flag this</h2>
        <p>{page.user_impact}</p>
        {page.technical_impact && <p>{page.technical_impact}</p>}
      </>
    )}

    <h2>{nested ? 'What the checks look at' : 'What the rule checks'}</h2>
    {page.checks.map((check) => <RuleCheck check={check} nested={nested} />)}

    <p class="generated">
      This page is generated from the rule catalogue and the rule contracts; see the
      <a href={url('rules/')}>rule overview</a> for how the outcome classes are derived.
    </p>
  </div>
</Base>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 24px 96px;
  }
  .crumb {
    margin-bottom: 16px;
    font-size: 14px;
  }
  h1 {
    margin: 0 0 8px;
    color: var(--heading);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  h2 {
    margin: 40px 0 12px;
    color: var(--heading);
    font-size: 22px;
    font-weight: 600;
  }
  .id {
    margin: 0 0 28px;
  }
  code {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.86em;
  }
  .facts {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 10px 24px;
    margin: 0;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .generated {
    margin-top: 48px;
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .facts dd {
      margin-bottom: 12px;
    }
  }
</style>
