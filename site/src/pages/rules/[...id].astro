---
import { CodeBlock } from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import { type Example, outcomes, repoUrl, type RulePage, rulePages } from '../../lib/rules';

export function getStaticPaths() {
  return rulePages.map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: RulePage };
const outcome = outcomes[page.outcome];
// The contract text is hard-wrapped: a blank line separates paragraphs, a single break is a space.
const expectation = page.expectation.split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, ' ').trim());
const criterion = page.criterion ? `${page.criterion}${page.level ? ` (level ${page.level})` : ''}` : undefined;

const verdictText: Record<Example['verdict'], string> = {
  violation: 'The rule reports a violation on this page.',
  needs_review: 'The rule flags this page for review.',
  pass: 'The page conforms; the rule reports nothing.',
  absent: 'The rule reports nothing on this page.',
};
const examples = [
  { heading: 'Failing example', example: page.failing },
  { heading: 'Passing example', example: page.passing },
].flatMap((e) => (e.example ? [{ heading: e.heading, example: e.example }] : []));
---

<Base title={`${page.title} (${page.id})`} description={`${page.title}: what the rule ${page.id} checks and why it is flagged.`}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url('rules/')}>All rules</a>
    </nav>
    <h1>{page.title}</h1>
    <p class="id"><code>{page.id}</code></p>

    <dl class="facts">
      {criterion && (<><dt>WCAG success criterion</dt><dd>{criterion}</dd></>)}
      <dt>Outcome class</dt>
      <dd><strong>{outcome.label}.</strong> {outcome.meaning}</dd>
      <dt>Area</dt>
      <dd>{page.dimension}, {page.subcategory}</dd>
      <dt>Default severity</dt>
      <dd>{page.severity}</dd>
      {page.axe_id && (<><dt>axe-core rule</dt><dd><code>{page.axe_id}</code></dd></>)}
      <dt>Detection</dt>
      <dd>{page.method}; needs {page.capabilities.join(', ')}</dd>
    </dl>

    <h2>Why we flag this</h2>
    <p>{page.user_impact}</p>
    <p>{page.technical_impact}</p>

    <h2>What the rule checks</h2>
    <h3>Applies to</h3>
    <p>{page.applicability}</p>
    <h3>Expectation</h3>
    {expectation.map((p) => <p>{p}</p>)}
    {page.manual_reason && (<><h3>Why a person has to decide</h3><p>{page.manual_reason}</p></>)}
    <h3>Source</h3>
    <p>{page.source}</p>

    {examples.map(({ heading, example }) => (
      <section>
        <h2>{heading}</h2>
        <p>
          {verdictText[example.verdict]} Fixture page <a href={`${repoUrl}/blob/main/${example.file}`}><code>{example.case}</code></a>
          from the detection corpus{example.selector && (<> , element <code>{example.selector}</code></>)}.
          The page may contain further findings for other rules.
        </p>
        <CodeBlock code={example.html} lang="html" title={example.file.split('/').pop()} label="HTML" />
      </section>
    ))}

    <p class="generated">
      This page is generated from the rule catalogue and the rule contract; see the
      <a href={url('rules/')}>rule overview</a> for how the outcome classes are derived.
    </p>
  </div>
</Base>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 24px 96px;
  }
  .crumb {
    margin-bottom: 16px;
    font-size: 14px;
  }
  h1 {
    margin: 0 0 8px;
    color: var(--heading);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  h2 {
    margin: 40px 0 12px;
    color: var(--heading);
    font-size: 22px;
    font-weight: 600;
  }
  h3 {
    margin: 20px 0 6px;
    color: var(--heading);
    font-size: 15px;
    font-weight: 600;
  }
  .id {
    margin: 0 0 28px;
  }
  code {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.86em;
  }
  .facts {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 10px 24px;
    margin: 0;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .generated {
    margin-top: 48px;
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .facts dd {
      margin-bottom: 12px;
    }
  }
</style>
